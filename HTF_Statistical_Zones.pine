//@version=6
// HTF Statistical Zones (MNQ / MES / MYM / MGC)
// Day zones: Yahoo daily 2001-2026 (context-adjusted). Sessions, opening ranges, targets, gap fill, invalidation,
// setups and signals: Databento 1-minute 2010-2026. Every shown stat held in both 2010-18 and 2019-26.
// Fixed levels are set once (18:00 day open, 9:30 / 9:45 / 10:00 / session starts) and never move.
// Rebuild with pine/assemble.py after editing; constants are generated by research/*.py.
indicator("HTF Statistical Zones", "HTF Zones", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────── inputs
bool biasMode = true   // the old "Full stats" live rows were removed 2026-10-05 (token limit)
minimal    = input.bool(false, "Minimal mode (AM zones, next-move odds, top 2 targets)", tooltip = "Hides the day zones, opening-range lines, midday/PM boxes, invalid / far-side / setup lines and all but the two highest-odds targets. Nothing is deleted - turn it off to see everything again.")
G1 = "Day zones (fixed at the 18:00 NY open)"
showDaily  = input.bool(true, "Show day zones", group = G1) and not minimal
innerPct   = input.string("70", "Zone from", options = ["50", "70", "80"], group = G1, inline = "pct")
outerPct   = input.string("90", "to percentile", options = ["80", "90", "95"], group = G1, inline = "pct", tooltip = "The 90% line: historically the day's high stayed below it (or the low above it) on 90% of days, after adjusting for today's context.")
showDLbl   = input.bool(true, "Price labels", group = G1)
showOpen   = input.bool(true, "18:00 open line", group = G1)
daysBack   = input.int(2, "Days to keep", minval = 1, maxval = 30, group = G1)
fitMode    = input.string("Inner edges", "Fit zones in view", options = ["Off", "Inner edges", "Full zones"], group = G1, tooltip = "TradingView auto-scale ignores boxes. Inner edges keeps the start of both zones on screen; Full zones keeps the outer lines too (squeezes candles).")
upBase     = input.color(#e05252, "Upper", group = G1, inline = "dc")
dnBase     = input.color(#2aa889, "Lower", group = G1, inline = "dc")
zoneW      = input.int(1, "Zone edge width", minval = 1, maxval = 4, group = G1)
openCol    = input.color(#8b949e73, "18:00 open line", group = G1, inline = "op")
openStyle  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = G1, inline = "op")


G4 = "Session boxes (each fixed at its own start)"
showW1  = input.bool(true, "AM 9:30-11:30", group = G4)
showW2  = input.bool(true, "Midday 11:30-13:30", group = G4) and not minimal
showW3  = input.bool(true, "PM 13:30-16:00", group = G4) and not minimal
sessCol = input.color(#7a8ca8, "Box color", group = G4)
sessDays = input.int(1, "Days of session / OR boxes to keep", minval = 1, maxval = 5, group = G4)

G5 = "Opening range (9:30 NY)"
showOR15 = input.bool(true, "OR 9:30-9:45", group = G5) and not minimal
showOR30 = input.bool(true, "OR 9:30-10:00", group = G5) and not minimal
orCol    = input.color(#4fa3e0, "OR color", group = G5)
showTags = input.bool(true, "Likely targets by 11:30 (overnight / prior-day highs & lows)", group = G5)
tagCol   = input.color(#b07cd8, "Target color", group = G5)
tgtOffB  = input.int(55, "Target lines: start bars to the right", minval = 0, maxval = 200, group = G5, inline = "tof", tooltip = "Purple target lines start this many bars to the right of the bar that draws them and run for the length, so they stay out of the price action.")
tgtLenB  = input.int(8, "length (bars)", minval = 3, maxval = 200, group = G5, inline = "tof")
amzCol   = input.color(#7a8ca8, "Likely AM high / low zones", group = G5)
tagStyle = input.string("Dashed", "Target line", options = ["Solid", "Dashed", "Dotted"], group = G5, inline = "tgs")
tagW     = input.int(1, "width", minval = 1, maxval = 4, group = G5, inline = "tgs")
orW      = input.int(1, "Opening-range line width", minval = 1, maxval = 4, group = G5)
invCol   = input.color(#9aa0a6, "Stop / invalidation", group = G5, inline = "inv")
invStyle = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = G5, inline = "inv")
farCol   = input.color(#e8a33d, "Failed-break far side", group = G5)
clearHit = input.bool(true, "Remove a level once price trades through it", group = G5)
minOdds  = input.int(40, "Min target odds %", minval = 10, maxval = 90, step = 5, group = G5, tooltip = "Hide target labels below these odds (the tested odds never change, only what is drawn). Raise it for a cleaner chart.") / 100.0
clear1130 = input.bool(true, "Clear morning levels after 11:30", group = G5)

G2 = "Live"
showTable  = input.bool(true, "Table", group = G2)
tblFull    = input.string("Compact", "Table detail", options = ["Compact", "Full"], group = G2, tooltip = "Compact hides rows the chart already shows (opening-range boxes, target labels, zone highlight) and the minor week / volume rows.") == "Full"
lblCol     = input.color(#000000, "Chart label text", group = G2, inline = "lbl")
pushMin    = input.int(60, "Show push-target line when new high / low odds ≥ %", minval = 0, maxval = 100, step = 5, group = G2) / 100.0
lblBig     = input.bool(true, "bigger", group = G2, inline = "lbl")
tblPos     = input.string("Top right", "Table position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G2)

G3 = "Extra layers (off = cleaner chart)"
show4H     = input.bool(false, "4H block 80% lines (18/22/02/06/10/14 NY)", group = G3)
showSess   = input.bool(false, "Prior day / Asia / London / overnight levels", group = G3)
asiaStat   = input.string("18:00-0:00", "Asia stat boxes", options = ["18:00-0:00", "20:00-0:00", "Off"], group = G3, inline = "as")
asiaCol    = input.color(#7a8ca8, "", group = G3, inline = "as")
hCol       = input.color(#6c8fb8, "4H", group = G3, inline = "oc")
h4Style    = input.string("Solid", "4H line", options = ["Solid", "Dashed", "Dotted"], group = G3, inline = "h4s")
h4W        = input.int(2, "width", minval = 1, maxval = 4, group = G3, inline = "h4s")

G0 = "Advanced"
symOverride = input.string("Auto", "Statistics set", options = ["Auto", "NQ", "ES", "YM", "GC"], group = G0, tooltip = "Auto reads the chart root (MNQ/NQ, MES/ES, MYM/YM, MGC/GC).")
useIV       = input.bool(true, "Blend implied volatility into the equity scale (VXN/VIX/VXD)", group = G0)

f_ls(string st) => st == "Solid" ? line.style_solid : st == "Dashed" ? line.style_dashed : line.style_dotted

// ─────────────────────────────────────────────────────────── instrument
string root = syminfo.root
int autoIdx = root == "MNQ" or root == "NQ" ? 0 : root == "MES" or root == "ES" ? 1 : root == "MYM" or root == "YM" ? 2 : root == "MGC" or root == "GC" ? 3 : -1
int symIdx = symOverride == "NQ" ? 0 : symOverride == "ES" ? 1 : symOverride == "YM" ? 2 : symOverride == "GC" ? 3 : autoIdx
bool supported = symIdx >= 0
int S = supported ? symIdx : 0
string symName = S == 0 ? "NQ" : S == 1 ? "ES" : S == 2 ? "YM" : "GC"
string ivSym = S == 0 ? "CBOE:VXN" : S == 1 ? "CBOE:VIX" : S == 2 ? "CBOE:VXD" : "CBOE:GVZ"
bool blendScale = S != 3 and useIV          // gold uses the HAR scale (blend under-covered gold upside out of sample)

