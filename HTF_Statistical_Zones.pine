    else if s == 1
        a := array.from(0.084, 0.167, 0.289, 0.084, 0.174, 0.306, 0.099, 0.207, 0.358, 0.097, 0.221, 0.391, 0.115, 0.252, 0.415, 0.111, 0.249, 0.461)
    else if s == 2
        a := array.from(0.091, 0.187, 0.330, 0.086, 0.182, 0.322, 0.102, 0.209, 0.357, 0.099, 0.218, 0.407, 0.117, 0.259, 0.455, 0.115, 0.269, 0.458)
    else
        a := array.from(0.066, 0.150, 0.264, 0.074, 0.152, 0.283, 0.079, 0.172, 0.307, 0.090, 0.186, 0.332, 0.092, 0.208, 0.376, 0.093, 0.213, 0.397)
    a
var array<float> AMZ = f_amZone(S)
var array<box> amzQ = array.new<box>()
var array<line> amzL = array.new<line>()
var array<label> amzLb = array.new<label>()
f_drawAmZones() =>
    float zc1 = S == 0 ? 0.423 : S == 1 ? 0.454 : S == 2 ? 0.445 : 0.581
    float zc2 = S == 0 ? 0.612 : S == 1 ? 0.656 : S == 2 ? 0.646 : 0.848
    int zq = na(onUsed930) ? 1 : onUsed930 < zc1 ? 0 : onUsed930 > zc2 ? 2 : 1
    int zi = zq * 6
    int zEnd = time + 120 * 60000
    float hA = open + array.get(AMZ, zi) * dHar
    float hM = open + array.get(AMZ, zi + 1) * dHar
    float hB = open + array.get(AMZ, zi + 2) * dHar
    float lA = open - array.get(AMZ, zi + 3) * dHar
    float lM = open - array.get(AMZ, zi + 4) * dHar
    float lB = open - array.get(AMZ, zi + 5) * dHar
    // stretch: out to the AM session box's 90% edge (70-90% of mornings stayed inside), stacked on the likely box
    float scZ = dHar * (na(ctxMult) ? 1.0 : ctxMult)
    float sU = math.max(open + array.get(f_ss_am(S), 1) * scZ, hB)
    float sD = math.min(open - array.get(f_ss_am(S), 3) * scZ, lB)
    array.push(amzQ, box.new(time, hB, zEnd, hA, xloc = xloc.bar_time, border_color = color.new(amzCol, 35), border_width = 1, bgcolor = color.new(amzCol, 93)))
    array.push(amzQ, box.new(time, lA, zEnd, lB, xloc = xloc.bar_time, border_color = color.new(amzCol, 35), border_width = 1, bgcolor = color.new(amzCol, 93)))
    array.push(amzL, line.new(time, sU, zEnd, sU, xloc = xloc.bar_time, color = color.new(amzCol, 40), style = line.style_dotted))
    array.push(amzL, line.new(time, sD, zEnd, sD, xloc = xloc.bar_time, color = color.new(amzCol, 40), style = line.style_dotted))
    array.push(amzL, line.new(time, hM, zEnd, hM, xloc = xloc.bar_time, color = color.new(amzCol, 0), width = 2))
    array.push(amzL, line.new(time, lM, zEnd, lM, xloc = xloc.bar_time, color = color.new(amzCol, 0), width = 2))
    string zTip = "Where the 9:30-11:30 high / low usually lands from the 9:30 open: shaded = middle 50% of days, dotted = median, for mornings with this size of overnight range (Databento 2010-26; 2010-18 bands held 45-56% of 2019-26 days)."
    while array.size(amzQ) > sessDays * 2
        box.delete(array.shift(amzQ))
    while array.size(amzL) > sessDays * 4
        line.delete(array.shift(amzL))
    while array.size(amzLb) > sessDays * 4
        label.delete(array.shift(amzLb))
    true
if showTags and intraday and timeframe.in_seconds() <= 900 and startOf(570) and not na(dHar)
    f_drawAmZones()
var label nxHL = na
var label nxLL = na
var line nxPHL = na
var line nxPLL = na
// typical wait (minutes) until the new high / low comes, given it comes: by time left (<30/30-60/60-90/>90 min) and
// distance (<=0.05 / 0.05-0.15 / >0.15 x daily range); medians, every era within ~2 min (Databento 1m 2010-26)
f_nxWait(float left, float dist) =>
    int lb = left < 30 ? 0 : left < 60 ? 1 : left < 90 ? 2 : 3
    float r = dist <= 0.05 ? 2.0 : dist <= 0.15 ? array.get(array.from(8.0, 12.0, 13.0, 11.0), lb) : array.get(array.from(14.0, 25.0, 31.0, 28.0), lb)
    r
f_byTime(float mins) =>
    int tB = math.min(time + barMs + int(mins * 60000), timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 11, 30))
    " by " + str.format_time(tB, "H:mm", "America/New_York")
if barstate.islast and not na(nxH) and showTags
    f_liveLevels(690 - chkT, math.max(amHi - amLo, syminfo.mintick) / dHar, na(mnOpen) ? 0.0 : o930 > mnOpen ? 1.0 : -1.0)
if barstate.islast
    label.delete(nxHL)
    label.delete(nxLL)
    line.delete(nxPHL)
    line.delete(nxPLL)
    if not na(nxH)
        float lftN = 690 - chkT
        // push-target line: where the new high / low typically ends, shown when its odds are >= the setting
        if nxH >= pushMin
            nxPHL := line.new(time, amHi + nxEH, time + 12 * barMs, amHi + nxEH, xloc = xloc.bar_time, color = color.new(dnBase, 20), style = line.style_dashed, width = 2)
        if nxL >= pushMin
            nxPLL := line.new(time, amLo - nxEL, time + 12 * barMs, amLo - nxEL, xloc = xloc.bar_time, color = color.new(upBase, 20), style = line.style_dashed, width = 2)
        nxHL := label.new(time, amHi, "new high " + str.tostring(math.round(nxH * 100)) + "% (+" + fmtPts(nxEH) + ")" + f_byTime(f_nxWait(lftN, (amHi - close) / dHar)), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Chance price trades above the 9:30-11:30 high so far before 11:30 (16 yrs, calibrated out of sample).")
        nxLL := label.new(time, amLo, "new low " + str.tostring(math.round(nxL * 100)) + "% (−" + fmtPts(nxEL) + ")" + f_byTime(f_nxWait(lftN, (close - amLo) / dHar)), xloc = xloc.bar_time, style = label.style_label_up, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Chance price trades below the 9:30-11:30 low so far before 11:30 (16 yrs, calibrated out of sample).")
// 9:45 refresh of the target labels: odds re-measured from the 9:45 close for levels not yet tagged (distance only;
// the 9:30-9:45 candle direction made no difference). Databento 2010-26, eras within ~0.05.
// 9:45 odds also depend on the 9:30-9:45 size: a large opening candle makes the 0.2-0.5x targets ~10-20 pts likelier
// than a small one (every era, all markets; research/gen_tag945_size.py)
var array<float> TAG945SZ = f_tag945sz(S)
f_refresh945() =>
    for li3 = 0 to array.size(tLbQ) - 1
        label lb3 = array.get(tLbQ, li3)
        bool fx3 = not na(lb3) and isFixedLb(label.get_text(lb3))
        bool isVw = not na(lb3) and (str.startswith(label.get_text(lb3), "ON VWAP") or str.startswith(label.get_text(lb3), "VWAP y"))
        bool isOp = not na(lb3) and (str.startswith(label.get_text(lb3), "Midnight") or str.startswith(label.get_text(lb3), "Wk open") or str.startswith(label.get_text(lb3), "Mo open"))
        // open-type levels from the 9:45 close (midnight / week / month open, untouched by 9:45), both eras
        if isOp and label.get_x(lb3) > time
            float lvo = label.get_y(lb3)
            string nmo = str.startswith(label.get_text(lb3), "Midnight") ? "Midnight" : str.startswith(label.get_text(lb3), "Wk open") ? "Wk open" : "Mo open"
            int bo = vwBin(math.abs(lvo - close[1]) / dHar)
            array<float> OP9 = array.from(0.87, 0.67, 0.50, 0.27, 0.04)
            if S == 0
                OP9 := array.from(0.92, 0.82, 0.62, 0.38, 0.06)
            else if S == 1
                OP9 := array.from(0.92, 0.77, 0.57, 0.34, 0.05)
            else if S == 2
                OP9 := array.from(0.89, 0.78, 0.54, 0.34, 0.05)
            bool dno = or15H >= lvo and or15L <= lvo
            label.set_text(lb3, nmo + (dno ? " hit" : " " + str.tostring(math.round(array.get(OP9, bo) * 100)) + "%"))
        if isVw and label.get_x(lb3) > time
            float lvv = label.get_y(lb3)
            bool onv = str.startswith(label.get_text(lb3), "ON VWAP")
            bool dv = or15H >= lvv and or15L <= lvv
            int bv = vwBin(math.abs(lvv - close[1]) / dHar)
            float pv9 = onv ? array.get(f_vw945On(S), bv) : array.get(f_vw945Rth(S), bv)
            label.set_text(lb3, (onv ? "ON VWAP" : "VWAP y") + (dv ? " hit" : " " + str.tostring(math.round(pv9 * 100)) + "%"))
        if not na(lb3) and not fx3 and not isVw and not isOp and label.get_x(lb3) > time
            float lv3 = label.get_y(lb3)
            bool done = lv3 >= close[1] ? or15H >= lv3 : or15L <= lv3
            float d3 = math.abs(lv3 - close[1]) / dHar
            int b3 = d3 <= 0.1 ? 0 : d3 <= 0.2 ? 1 : d3 <= 0.35 ? 2 : d3 <= 0.5 ? 3 : 4
            // keep only the level names, then the refreshed odds (cleaner than stacking the 9:30 numbers)
            array<string> parts = str.split(label.get_text(lb3), " · ")
            string names = ""
            for pt in parts
                string w0 = array.get(str.split(pt, " "), 0)
                if w0 == "ONH" or w0 == "ONL" or w0 == "PDH" or w0 == "PDL" or w0 == "PWH" or w0 == "PWL" or w0 == "GAP" or w0 == "Wk" or w0 == "Mo"
                    names := names + (names == "" ? "" : "/") + (w0 == "Wk" ? "Wk " + array.get(str.split(pt, " "), 1) : w0 == "Mo" ? "Mo open" : w0)
            array<float> cut3 = f_or15_cut(S)
            float w3 = (or15H - or15L) / dHar
            int z3 = w3 < array.get(cut3, 0) ? 0 : w3 > array.get(cut3, 1) ? 2 : 1
            label.set_text(lb3, names + (done ? " hit" : " " + str.tostring(math.round(array.get(TAG945SZ, z3 * 5 + b3) * 100)) + "%"))
    true
if showTags and intraday and nyT >= 585 and nyTprev < 585 and not na(dHar) and not na(or15H) and array.size(tLbQ) > 0
    f_refresh945()


// ─────────────────────────────────────────────────────────── live layer
int hrIdx = (nyHour - 18 + 24) % 24

// ─────────────────────────────────────────────────────────── next break + likely close area (live)

// ─────────────────────────────────────────────────────────── week so far (Tue-Fri)

// ─────────────────────────────────────────────────────────── week / month / 4H lines

int myBlk = int(math.floor(hrIdx / 4))
bool newBlk = intraday and timeframe.in_seconds() <= 3600 and (myBlk != myBlk[1] or newDay)
var array<line> h4Q = array.new<line>()
f_blk7() =>
    int bEnd = na(dayEnd) ? time + 4 * 3600000 : math.min(time + 4 * 3600000, dayEnd)
    array.push(h4Q, line.new(time, open + array.get(HQU, 1) * hScale, bEnd, open + array.get(HQU, 1) * hScale, xloc = xloc.bar_time, color = color.new(hCol, 20), style = f_ls(h4Style), width = h4W))
    array.push(h4Q, line.new(time, open - array.get(HQD, 1) * hScale, bEnd, open - array.get(HQD, 1) * hScale, xloc = xloc.bar_time, color = color.new(hCol, 20), style = f_ls(h4Style), width = h4W))
    while array.size(h4Q) > 12
        line.delete(array.shift(h4Q))
    true
if show4H and newBlk and not na(hScale)
    f_blk7()

// ─────────────────────────────────────────────────────────── session levels (context only)
var float asiaH = na
var float asiaL = na
var float lonH = na
var float lonL = na
bool inAsia = hrIdx < 6
bool inLon = (nyHour == 1 and nyMin >= 30) or (nyHour >= 2 and nyHour < 5)
bool inON = hrIdx < 15 or (nyHour == 9 and nyMin < 30)
if newDay
    pdH := tdH
    pdL := tdL
    tdH := high
    tdL := low
    asiaH := na
    asiaL := na
    lonH := na
    lonL := na
    onH := na
    onL := na
else
    tdH := math.max(tdH, high)
    tdL := math.min(tdL, low)
if inAsia
    asiaH := na(asiaH) ? high : math.max(asiaH, high)
    asiaL := na(asiaL) ? low : math.min(asiaL, low)
if inLon
    lonH := na(lonH) ? high : math.max(lonH, high)
    lonL := na(lonL) ? low : math.min(lonL, low)
if inON
    onH := na(onH) ? high : math.max(onH, high)
    onL := na(onL) ? low : math.min(onL, low)
// gold only: first 1h bar through the Asia high / low after 00:00 (same event definition as the research)
var float  hrH = na
var float  hrL = na
var bool   asiaHiDone = false
var bool   asiaLoDone = false
var string gSweep = ""
bool newHour = intraday and timeframe.in_seconds() <= 3600 and timeframe.change("60")
if newDay
    asiaHiDone := false
    asiaLoDone := false
    gSweep := ""
if S == 3 and newHour and not newDay and not na(hrH) and hrIdx > 6 and not na(asiaH)
    // the hour that just completed: high/low tracked below, close = previous bar's close
    if not asiaHiDone and hrH > asiaH
        asiaHiDone := true
        if close[1] <= asiaH and gSweep == ""
            gSweep := "▲ high swept, closed inside"
    if not asiaLoDone and hrL < asiaL
        asiaLoDone := true
        if close[1] >= asiaL and gSweep == ""
            gSweep := "▼ low swept, closed inside"
if newHour or newDay
    hrH := high
    hrL := low
else
    hrH := math.max(hrH, high)
    hrL := math.min(hrL, low)

bool sx = showSess and intraday
plot(sx ? pdH : na, "Prior day high", color.new(#8b949e, 35), 1, plot.style_linebr)
plot(sx ? pdL : na, "Prior day low", color.new(#8b949e, 35), 1, plot.style_linebr)
plot(sx and not inAsia ? asiaH : na, "Asia high", color.new(#e05252, 55), 1, plot.style_linebr)
plot(sx and not inAsia ? asiaL : na, "Asia low", color.new(#e05252, 55), 1, plot.style_linebr)
plot(sx and not inLon and nyHour >= 5 ? lonH : na, "London high", color.new(#4a7fe0, 55), 1, plot.style_linebr)
plot(sx and not inLon and nyHour >= 5 ? lonL : na, "London low", color.new(#4a7fe0, 55), 1, plot.style_linebr)
plot(sx and not inON ? onH : na, "Overnight high", color.new(#e09a3a, 55), 1, plot.style_linebr)
plot(sx and not inON ? onL : na, "Overnight low", color.new(#e09a3a, 55), 1, plot.style_linebr)

// ─────────────────────────────────────────────────────────── table (only what matters)
var table tb = table.new(tblPos == "Top right" ? position.top_right : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Top left" ? position.top_left : position.bottom_left, 2, 21, bgcolor = color.new(#0d1117, 8), frame_color = color.new(#30363d, 0), frame_width = 1, border_width = 0)
cellT(int r, string a, string b, color c, string tip) =>
    table.cell(tb, 0, r, a, text_color = txtDim, text_size = size.normal, text_halign = text.align_left, tooltip = tip)
    table.cell(tb, 1, r, b, text_color = c, text_size = size.normal, text_halign = text.align_right, tooltip = tip)

// table drawing wrapped in a function: keeps the script's main body under Pine's size limit (CE10295)
f_drawTable() =>
    table.clear(tb, 0, 0, 1, 20)
    if not intraday
        cellT(0, "HTF Zones", "use an intraday chart", txtMain, "")
    else if na(sigma)
        cellT(0, symName + " day", "waits for 18:00 open", txtMain, "Zones start at the next futures-day open.")
    else
        string tone = ctxMult < 0.93 ? "quieter" : ctxMult > 1.07 ? "bigger" : "normal"
        color toneC = ctxMult < 0.93 ? color.new(#7aa2c8, 0) : ctxMult > 1.07 ? color.new(#e3b341, 0) : txtMain
        int r = 0
        string bTxt = bias == 1 ? "LONG" : bias == -1 ? "SHORT" : "NEUTRAL"
        color bC = bias == 1 ? color.new(dnBase, 0) : bias == -1 ? color.new(upBase, 0) : txtMain
        string tgt = bias == 1 ? fmtPx(uIn) + " – " + fmtPx(uOut) : bias == -1 ? fmtPx(lIn) + " – " + fmtPx(lOut) : "both zones"
        cellT(r, symName + (supported ? "" : "?") + " " + tone, fmtPts(sigma) + " pts · " + bTxt + (bias != 0 ? " " + biasPct : ""), bias != 0 ? bC : toneC, "Why this day size:\n" + ctxText + "\n\nBias (locked at 18:00): " + biasWhy + " rule, right on day direction " + biasPct + " historically (both eras). Default is the trend filter (50d vs 200d avg, open vs 20d avg); tested overrides: NQ Mondays long (60-62%), YM after a quiet day follow the 20-day trend (57%). A lean, not a signal. Bias-side zone: " + tgt)
        r += 1
        if not na(nxH)
            cellT(r, "Next", "new high " + str.tostring(math.round(nxH * 100)) + "% (+" + fmtPts(nxEH) + ") · new low " + str.tostring(math.round(nxL * 100)) + "% (−" + fmtPts(nxEL) + ")", nxH - nxL >= 0.15 ? color.new(dnBase, 0) : nxL - nxH >= 0.15 ? color.new(upBase, 0) : txtMain, "Live: chance price still makes a new 9:30-11:30 high / low before 11:30, from time left, distance to the high / low, the range so far, the move since 9:30 and the midnight side. Fitted 2010-18; tested 2019-22 and 2023-26: calibrated within ~3 points per decile, Brier 0.13 vs 0.23 for a flat guess, all four markets.")
            r += 1
        if expTxt != ""
            cellT(r, "Expect", expTxt, txtMain, expTip != "" ? expTip : "Typical (median) 9:30-10:00 range for mornings like this one, from the overnight range size and news, then the typical full 9:30-11:30 range (Databento 2010-26, stable in both eras).")
            r += 1
        // Plan (compact): setup + 9:45 / 10:00 target-and-stop (or the OR break state once no plan is live) + best target
        string setS = setupTxt == "" ? "" : str.contains(setupTxt, "edge gone") ? "setup: edge gone" : str.substring(setupTxt, 0, 1) + " setup " + str.match(setupTxt, "[0-9]+-?[0-9]*%")
        // best live target: the highest-odds target label still on the chart (hit ones are removed), else the 9:30 pick
        string tgtS = ""
        float tgtP = -1.0
        int nLb = array.size(tLbQ)
        if nLb > 0 and nyT >= 570 and nyT < 690
            for liT = 0 to nLb - 1
                label lbT = array.get(tLbQ, liT)
                string tx = label.get_text(lbT)
                if label.get_x(lbT) > time and not str.startswith(tx, "AM ") and not str.contains(tx, "hit")
                    array<string> tk = str.split(tx, " ")
                    string nmT = ""
                    float pT = na
                    for w in tk
                        if str.endswith(w, "%") and na(pT)
                            pT := str.tonumber(str.replace(w, "%", ""))
                        else if na(pT)
                            nmT := nmT + (nmT == "" ? "" : " ") + w
                    if not na(pT) and pT > tgtP
                        tgtP := pT
                        tgtS := nmT + " " + fmtPx(label.get_y(lbT)) + " " + str.tostring(pT) + "%"
        if tgtS == "" and tagTxt != ""
            tgtS := str.replace(tagTxt, " · ", " " + fmtPx(bestLv) + " ", 0) + (bestDone ? " ✓" : "")
        string planB = holdDir != 0 ? holdTxt : invTxt != "" ? invTxt : holdTxt
        string planTxt = setS
        if planB != ""
            planTxt := planTxt + (planTxt != "" ? " · " : "") + planB
        if tgtS != ""
            planTxt := planTxt + (planTxt != "" ? " · " : "") + "target " + tgtS
        if not tblFull and planTxt != ""
            cellT(r, nyT < 585 ? "Plan" : nyT >= 600 ? "Plan 10:00" : "Plan 9:45", planTxt, setupTxt != "" ? setupC : txtMain, holdTip != "" ? holdTip : "Best tested target and stop for the morning. Full table mode shows each part on its own row.")
            r += 1
        if tblFull and (or15Txt != "" or or30Txt != "")
            cellT(r, "Opening range", (or15Txt != "" ? "15m " + or15Txt : "") + (or30Txt != "" ? (or15Txt != "" ? "  |  " : "") + "30m " + or30Txt : ""), color.new(orCol, 0), or15Tip + (or30Tip != "" ? "\n\n" + or30Tip : ""))
            r += 1
        if tblFull and holdTxt != ""
            cellT(r, nyT >= 600 ? "10:00 plan" : "9:45 plan", holdTxt, holdDir == 0 ? txtDim : txtMain, holdTip)
            r += 1
        if tblFull and setupTxt != ""
            cellT(r, "Setup", setupTxt, setupC, "Audited as displayed (one setup per day): NQ A 60-63%, NQ B 56-57%, ES B 57-63%, gold 56-58%, 9:45 -> 11:30, both 2010-18 and 2019-26, 100+ cases each. A = opened above yesterday's high + green 9:30-9:45; B = heavy 9:30-9:45 volume + overnight 4H majority agree with the opening candle. If price trades back through the 9:30 open before 10:30, the setup direction wins only 50-56% from there (2010-26, NQ/ES/YM): the edge is used up, but it is not a reversal signal.")
            r += 1
        if tblFull and volTxt != ""
            cellT(r, "Open volume", volTxt, color.new(#e3b341, 0), "9:30-9:45 volume versus its 20-day average (>1.25x = heavy). Feeds setup B. On YM the opening candle direction held into 11:30 56.3% in both eras.")
            r += 1
        if tblFull and invTxt != ""
            cellT(r, "OR break", invTxt, txtMain, "Invalidation from 16 years of 1-minute data: once price comes back 0.5 OR width inside after the first break, the break rarely works.")
            r += 1
        if tblFull and tagTxt != ""
            cellT(r, "Target", tagTxt, color.new(tagCol, 0), "The overnight / prior-day high or low most likely to be tagged by 11:30, given its distance from the 9:30 open.")
            r += 1
        if zoneTxt != ""
            cellT(r, "Zone", zoneTxt, txtMain, "9:30 opened beyond a day-zone line. Since 2010 (both 2010-18 and 2019-26, all four markets) the next line out was usually reached by 11:30 and a full return to the 18:00 open was rare, so fading back to the open is a low-odds idea on these mornings.")
            r += 1
        if profTxt != ""
            cellT(r, "Profile", profTxt, txtMain, "Daily profile from the midnight (0:00) open. Since 2010, when 9:30 opened above it, the 9:30-11:30 window set the futures-day low on only 6-16% of days (NQ 13-16, ES 9-11, YM 9-15, gold 6-8%) and the high on 24-36%; below it, the day high only 5-14% and the low 26-36%. Stable in 2010-18, 2019-22 and 2023-26. Week: when 9:30 is above the Sunday 18:00 week open, this morning set the week low on 0-6% of days; below it, the week high on 0-5%.")
            r += 1
        if sessTxt != ""
            cellT(r, "Session", sessTxt, sessC, "Bias of the current session box. Rule and hit rate come from this chart's own history.")
            r += 1
        if newsTxt != ""
            cellT(r, "News", newsTxt, newsIsToday ? color.new(#e3b341, 0) : txtMain, "Scheduled FOMC (2:00 ET), CPI and NFP (8:30 ET). Update the calendar yearly.")
            r += 1
        string monTxt = monDir == 1 ? "Mon up: Mon low " + fmtPx(monL) + " = week low 41-45%" : monDir == -1 ? "Mon down: Mon high " + fmtPx(monH) + " = week high 32-42%" : ""
        if monTxt != ""
            cellT(r, "Week", monTxt, txtMain, "26 years of daily data, all four markets, both halves: when Monday closes up, Monday's low ends up being the week's low 41-45% of the time (about 20% by chance) and its high is the week's high only 9-17%. When Monday closes down, Monday's high is the week's high 32-42% of the time. Rechecked on Databento 2010-26, all four markets, both eras.")
            r += 1
        if S == 3 and nyHour >= 13 and nyHour < 17
            cellT(r, "Gold", "day mostly done", txtDim, "After 13:00 NY the gold day high was already in on 82-84% of days and the low on 84-85% (Databento 2010-26, both eras; COMEX settles 13:30).")
    true
if showTable and barstate.islast
    f_drawTable()

// ─────────────────────────────────────────────────────────── clean-up: drop levels once they no longer matter
f_dropAll(array<line> ls, array<label> lbs) =>
    while array.size(ls) > 0
        line.delete(array.pop(ls))
    while array.size(lbs) > 0
        label.delete(array.pop(lbs))
    true
// a level is gone once price trades through it after it was drawn: delete its line and the label at its price
f_dropHit(array<line> ls, array<label> lbs, int off) =>
    int n = array.size(ls)
    if n > 0
        for i = n - 1 to 0
            line l = array.get(ls, i)
            float y = line.get_y1(l)
            int x2 = line.get_x2(l)
            if line.get_x1(l) - off < time and x2 > time and high >= y and low <= y
                int m = array.size(lbs)
                if m > 0
                    for j = m - 1 to 0
                        label b = array.get(lbs, j)
                        if label.get_x(b) == x2 and math.abs(label.get_y(b) - y) < syminfo.mintick
                            label.delete(b)
                            array.remove(lbs, j)
                line.delete(l)
                array.remove(ls, i)
    true
if intraday
    // setup / signal that hit its stop or its time stop: the whole plan no longer matters
    if pbHit or setStall
        f_dropAll(stQ, stLQ)
    if clearHit and nyT >= 570 and nyT < 690
        f_dropHit(tLQ, tLbQ, tOff)
        f_dropHit(iLQ, iLbQ, 0)
        f_dropHit(stQ, stLQ, 0)
        f_dropHit(oLQ, oLbQ, 0)
    if clear1130 and startOf(690)
        f_dropAll(tLQ, tLbQ)
        f_dropAll(iLQ, iLbQ)
        f_dropAll(stQ, stLQ)
        f_dropAll(oLQ, oLbQ)
        while array.size(oQ) > 0
            box.delete(array.pop(oQ))
        invTxt := ""
        setupTxt := ""
        tagTxt := ""

// ─────────────────────────────────────────────────────────── de-clutter: labels at ~the same time and price
// stack instead of overlapping (the higher one's text goes just above its price, the lower one's just below)
f_collect(array<label> q, array<label> all) =>
    int nq = array.size(q)
    if nq > 0
        for i = 0 to nq - 1
            label lb = array.get(q, i)
            if not na(lb) and label.get_x(lb) > time and label.get_text(lb) != ""
                array.push(all, lb)
    true
f_declutter() =>
    array<label> all = array.new<label>()
    f_collect(tLbQ, all)
    f_collect(iLbQ, all)
    f_collect(amzLb, all)
    f_collect(oLbQ, all)
    f_collect(stLQ, all)
    int n = array.size(all)
    if n > 1 and not na(dHar)
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                label a = array.get(all, i)
                label b = array.get(all, j)
                if math.abs(label.get_x(a) - label.get_x(b)) <= 3 * barMs and math.abs(label.get_y(a) - label.get_y(b)) < 0.03 * dHar
                    bool aHi = label.get_y(a) >= label.get_y(b)
                    label.set_style(aHi ? a : b, label.style_label_lower_left)
                    label.set_style(aHi ? b : a, label.style_label_upper_left)
    true
if barstate.islast
    f_declutter()

// minimal mode: keep only the two highest-odds live target labels/lines; hide invalid / far-side / setup drawings
f_hideL(array<line> ls, array<label> lbs) =>
    if array.size(ls) > 0
        for i = 0 to array.size(ls) - 1
            line.set_color(array.get(ls, i), color.new(color.black, 100))
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.set_textcolor(array.get(lbs, i), color.new(color.black, 100))
    true
f_oddsOf(string tx) =>
    float p = na
    for w in str.split(tx, " ")
        if na(p) and str.endswith(w, "%")
            p := str.tonumber(str.replace(w, "%", ""))
    p
f_minimal() =>
    f_hideL(iLQ, iLbQ)
    f_hideL(stQ, stLQ)
    int n = array.size(tLbQ)
    if n > 0
        array<float> ps = array.new<float>()
        for i = 0 to n - 1
            label lb = array.get(tLbQ, i)
            float p = label.get_x(lb) > time ? f_oddsOf(label.get_text(lb)) : na
            array.push(ps, na(p) ? -1.0 : p)
        array<float> srt = array.copy(ps)
        array.sort(srt, order.descending)
        float cut = array.size(srt) >= 2 ? array.get(srt, 1) : array.get(srt, 0)
        for i = 0 to n - 1
            label lb = array.get(tLbQ, i)
            bool keep = array.get(ps, i) >= cut and array.get(ps, i) >= 0
            label.set_textcolor(lb, keep ? lblCol : color.new(color.black, 100))
            int nl = array.size(tLQ)
            if nl > 0
                for j = 0 to nl - 1
                    line l = array.get(tLQ, j)
                    if line.get_x2(l) == label.get_x(lb) and math.abs(line.get_y1(l) - label.get_y(lb)) < syminfo.mintick
                        line.set_color(l, keep ? color.new(tagCol, 15) : color.new(color.black, 100))
    true
if barstate.islast and minimal
    f_minimal()


// ─────────────────────────────────────────────────────────── Asia stat boxes (drawn at the Asia open)
// Where the Asia high / low land from the session open (x daily HAR): darker = middle 50% of sessions, lighter = out to
// the 90% edge; Monday (Sunday 18:00 open) runs bigger. research/asia_zones.py: 2010-18 bands covered 44-61% of 2019-26
// sessions (target 50), the 90% edge held 82-95%.
var array<box> asQ = array.new<box>()
var array<line> asL = array.new<line>()
var array<label> asLb = array.new<label>()
f_asiaBoxes(int aStart) =>
    bool mon = dayofweek(time_tradingday, "UTC") == dayofweek.monday
    int k = (aStart == 1080 ? 0 : 8) + (mon ? 4 : 0)
    array<float> z = f_asiaZ(S)
    int aEnd = time + (1440 - aStart) * 60000
    float o = open
    for sd = 0 to 1
        float sg = sd == 0 ? 1.0 : -1.0
        float q25 = o + sg * array.get(z, k) * dHar
        float q50 = o + sg * array.get(z, k + 1) * dHar
        float q75 = o + sg * array.get(z, k + 2) * dHar
        float q90 = o + sg * array.get(z, k + 3) * dHar
        array.push(asQ, box.new(time, math.max(q25, q75), aEnd, math.min(q25, q75), xloc = xloc.bar_time, border_color = color.new(asiaCol, 35), border_width = 1, bgcolor = color.new(asiaCol, 93)))
        array.push(asL, line.new(time, q90, aEnd, q90, xloc = xloc.bar_time, color = color.new(asiaCol, 40), style = line.style_dotted))
        array.push(asL, line.new(time, q50, aEnd, q50, xloc = xloc.bar_time, color = color.new(asiaCol, 0), width = 2))
    while array.size(asQ) > sessDays * 2
        box.delete(array.shift(asQ))
    while array.size(asL) > sessDays * 4
        line.delete(array.shift(asL))
    while array.size(asLb) > daysBack * 2
        label.delete(array.shift(asLb))
    true
// ─────────────────────────────────────────────────────────── 17:00 close: clear the day's session / OR / AM-zone drawings
f_clearDay() =>
    for b in sQ
        box.delete(b)
    for b in oQ
        box.delete(b)
    for b in amzQ
        box.delete(b)
    for b in asQ
        box.delete(b)
    for l in oLQ
        line.delete(l)
    for l in amzL
        line.delete(l)
    for l in asL
        line.delete(l)
    for l in sL
        label.delete(l)
    for l in oLbQ
        label.delete(l)
    array.clear(sQ)
    array.clear(oQ)
    array.clear(amzQ)
    array.clear(asQ)
    array.clear(oLQ)
    array.clear(amzL)
    array.clear(asL)
    array.clear(sL)
    array.clear(oLbQ)
    true
if startOf(1020)
    f_clearDay()

int asStart = asiaStat == "18:00-0:00" ? 1080 : 1200
if asiaStat != "Off" and showTags and intraday and timeframe.in_seconds() <= 3600 and not na(dHar) and startOf(asStart)
    f_asiaBoxes(asStart)
