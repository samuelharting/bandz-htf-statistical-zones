// 9:30 open retest from 10:00: P(price trades back to the 9:30 open 10:00-11:30) by |10:00 price - 9:30 open| / daily
// HAR, bins <=.05 .1 .2 .35 >.35. Databento 1m 2010-26, every era (2010-18 / 2019-22 / 2023-26) within ~0.06, n 55-673.
f_open10(int s, int b) =>
    int r = b == 0 ? (s == 3 ? 89 : 91) : b == 1 ? (s == 3 ? 73 : s == 2 ? 76 : 75) : b == 2 ? (s == 3 ? 51 : s == 1 ? 56 : 57) : b == 3 ? (s == 0 ? 34 : s == 1 ? 32 : s == 2 ? 31 : 29) : (s == 0 ? 14 : s == 1 ? 15 : s == 2 ? 17 : 16)
    r
f_blk3() =>
    float dd = math.abs(open - o930) / dHar
    int ob = dd <= 0.05 ? 0 : dd <= 0.1 ? 1 : dd <= 0.2 ? 2 : dd <= 0.35 ? 3 : 4
    int op = f_open10(S, ob)
    if op >= minOdds * 100
        int t1130o = time + tOff + tLen
        array.push(tLQ, line.new(time + tOff, o930, t1130o, o930, xloc = xloc.bar_time, color = color.new(tagCol, op >= 50 ? 15 : 50), style = f_ls(tagStyle), width = tagW))
        array.push(tLbQ, label.new(t1130o, o930, "9:30 open " + str.tostring(op) + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Chance price trades back to the 9:30 open between 10:00 and 11:30, given how far price is from it at 10:00 (Databento 1m 2010-26; 2010-18, 2019-22 and 2023-26 all within ~6 points)."))
    true
if showTags and not na(dHar) and not na(o930) and startOf(600) and nyT < 690
    f_blk3()
// 9:30-10:30 high/low still standing at 11:30, when the 10:30 price is > 0.15x daily HAR away from it, by when it was
// set (Databento 1m 2010-26, 2010-18 / 2019-22 / 2023-26, n 175-1501 per cell/era). Closer than 0.15x: 25-59%, not shown.
f_amHold(int s, int w) =>
    int r = w == 0 ? (s == 0 ? 87 : s == 1 ? 86 : s == 2 ? 88 : 89) : w == 1 ? (s == 0 ? 83 : s == 1 ? 83 : s == 2 ? 81 : 87) : (s == 0 ? 70 : s == 1 ? 72 : s == 2 ? 74 : 78)
    r
var float amH = na
var float amL = na
var int amHt = 0
var int amLt = 0
if intraday and timeframe.in_seconds() <= 900 and nyT >= 570 and nyT < 630
    if nyTprev < 570 or nyTprev > nyT or na(amH)
        amH := high
        amL := low
        amHt := nyT
        amLt := nyT
    else
        if high > amH
            amH := high
            amHt := nyT
        if low < amL
            amL := low
            amLt := nyT
if newDay
    amH := na
    amL := na
f_blk4() =>
    int t1130h = time + tOff + tLen
    for sd = 0 to 1
        float lvA = sd == 0 ? amH : amL
        int tA = sd == 0 ? amHt : amLt
        if math.abs(open - lvA) / dHar > 0.15
            int pA = f_amHold(S, tA < 585 ? 0 : tA < 600 ? 1 : 2)
            array.push(tLQ, line.new(time + tOff, lvA, t1130h, lvA, xloc = xloc.bar_time, color = color.new(invCol, 30), style = f_ls(invStyle), width = 1))
            array.push(tLbQ, label.new(t1130h, lvA, (sd == 0 ? "AM high holds " : "AM low holds ") + str.tostring(pA) + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "At 10:30 price is more than 0.15x the daily range away from the 9:30-10:30 " + (sd == 0 ? "high" : "low") + ". Since 2010 that level stood until 11:30 " + str.tostring(pA) + "% of the time (set 9:30-9:45: 85-90%, 9:45-10:00: 79-88%, 10:00-10:30: 69-82%; stable in 2010-18, 2019-22 and 2023-26). Closer than that it is a coin flip."))
    true
if showTags and not na(dHar) and not na(amH) and startOf(630)
    f_blk4()
if newDay
    tagTxt := ""
if intraday and not bestDone and not na(bestLv) and nyT > 570 and nyT < 690 and high >= bestLv and low <= bestLv
    bestDone := true
// labels with their own tested odds (not refreshed by the 9:45 / 10:30 distance curves)
isFixedLb(string tx) => str.startswith(tx, "Gap CE") or str.startswith(tx, "8:30 open") or str.startswith(tx, "8:20 open") or str.startswith(tx, "9:30 open") or str.startswith(tx, "AM high") or str.startswith(tx, "AM low")
// 10:30 refresh of level labels (highs/lows/gap) for levels untouched since 9:30: by 11:30 ~80/62/36/15/2% by distance
// (.05/.1/.2/.35/inf x daily range) for the index futures, gold ~78/55/32/10/1% (both eras)
var float amHi = na
var float amLo = na
if intraday and startOf(570)
    amHi := high
    amLo := low
else if intraday and nyT > 570 and nyT < 690
    amHi := math.max(amHi, high)
    amLo := math.min(amLo, low)
// ─────────────────────────────────────────────────────────── live next-move odds (9:45-11:25)
// Chance price still makes a NEW 9:30-11:30 high / low before 11:30, from minutes left, distance to the high / low,
// range so far, move since 9:30 and the midnight side. Logistic fits on Databento 1m 2010-18; out of sample 2019-22 and
// 2023-26 Brier 0.13 vs 0.23 for a flat guess, calibrated within ~3 pts per decile (research/live_next_extreme.py).
// coef order: intercept, log(dist+.01), sqrt(left/120), log(dist+.01)*sqrt(left/120), range, move, midnight side, log(range+.02)
f_nxCoef(int s, bool up) =>
    array<float> c = array.new<float>()
    if s == 0 and up
        c := array.from(-8.493, -2.552, 7.593, 1.065, -0.27, 0.394, -0.049, 0.665)
    else if s == 0
        c := array.from(-7.313, -2.593, 7.521, 1.31, -1.492, 1.135, 0.039, 1.158)
    else if s == 1 and up
        c := array.from(-8.089, -2.535, 8.136, 1.187, -1.276, 1.045, -0.126, 0.991)
    else if s == 1
        c := array.from(-6.421, -2.557, 7.738, 1.223, -2.326, 1.193, 0.052, 1.864)
    else if s == 2 and up
        c := array.from(-8.846, -2.641, 7.958, 1.178, -0.333, 0.424, -0.093, 0.672)
    else if s == 2
        c := array.from(-7.01, -2.644, 7.491, 1.278, -1.852, 0.988, 0.029, 1.448)
    else if s == 3 and up
        c := array.from(-8.579, -2.676, 7.61, 1.165, -0.486, 0.423, 0.023, 0.842)
    else if s == 3
        c := array.from(-9.627, -2.897, 8.41, 1.461, -0.095, 0.93, -0.003, 0.68)
    c
f_nxProb(array<float> c, float dist, float left, float rngN, float ret, float side) =>
    float ld = math.log(math.max(dist, 0) + 0.01)
    float sq = math.sqrt(math.max(left, 0) / 120.0)
    float z = array.get(c, 0) + array.get(c, 1) * ld + array.get(c, 2) * sq + array.get(c, 3) * ld * sq + array.get(c, 4) * rngN + array.get(c, 5) * ret + array.get(c, 6) * side + array.get(c, 7) * math.log(rngN + 0.02)
    1.0 / (1.0 + math.exp(-z))
// typical push past the old high / low when a new one comes (median x daily range by minutes left <30/30-60/60-90/>90)
f_nxExt(int s, bool up, float left) =>
    int b = left < 30 ? 0 : left < 60 ? 1 : left < 90 ? 2 : 3
    float r = 0.0
    if s == 0
        r := up ? array.get(array.from(0.043, 0.080, 0.119, 0.157), b) : array.get(array.from(0.066, 0.110, 0.146, 0.170), b)
    else if s == 1
        r := up ? array.get(array.from(0.045, 0.077, 0.114, 0.145), b) : array.get(array.from(0.060, 0.100, 0.136, 0.161), b)
    else if s == 2
        r := up ? array.get(array.from(0.046, 0.079, 0.114, 0.145), b) : array.get(array.from(0.059, 0.097, 0.131, 0.157), b)
    else
        r := up ? array.get(array.from(0.054, 0.081, 0.112, 0.140), b) : array.get(array.from(0.058, 0.094, 0.125, 0.147), b)
    r
var array<float> NXU = f_nxCoef(S, true)
var array<float> NXD = f_nxCoef(S, false)
float nxH = na
float nxL = na
float nxEH = na
float nxEL = na
int barMin = int(timeframe.in_seconds() / 60)
int chkT = nyT + barMin
if intraday and timeframe.in_seconds() <= 900 and not na(dHar) and not na(amHi) and not na(o930) and chkT >= 585 and chkT <= 685
    float rN = math.max(amHi - amLo, syminfo.mintick) / dHar
    float sdM = na(mnOpen) ? 0.0 : o930 > mnOpen ? 1.0 : -1.0
    float lft = 690 - chkT
    nxH := f_nxProb(NXU, (amHi - close) / dHar, lft, rN, (close - o930) / dHar, sdM)
    nxL := f_nxProb(NXD, (close - amLo) / dHar, lft, rN, (o930 - close) / dHar, -sdM)
    nxEH := f_nxExt(S, true, lft) * dHar
    nxEL := f_nxExt(S, false, lft) * dHar
// live odds that an untouched ONH/ONL/PDH/PDL/PWH/PWL (beyond the AM high/low so far) trades before 11:30; logistic per
// market & side fitted 2010-18, calibrated out of sample 2019-26 (research/live_level_odds.py). Order: intercept, log(dist+.01),
// sqrt(left/120), product, range, move, midnight side, log(range+.02), log(beyond the AM extreme+.01)
f_lvCoef(int s, bool up) =>
    array<float> c = array.new<float>()
    if s == 0 and up
        c := array.from(-11.327, -3.082, 9.0, 1.365, 0.515, 0.883, -0.058, 0.705, -0.304)
    else if s == 0
        c := array.from(-9.155, -3.203, 7.974, 1.103, -0.122, 0.234, 0.055, 1.322, -0.013)
    else if s == 1 and up
        c := array.from(-9.735, -2.799, 8.204, 0.723, -0.997, 1.05, 0.007, 1.461, -0.341)
    else if s == 1
        c := array.from(-9.615, -3.281, 8.653, 1.205, -0.249, 0.193, -0.011, 1.646, -0.218)
    else if s == 2 and up
        c := array.from(-10.342, -3.248, 8.23, 0.948, -0.237, 0.271, -0.054, 1.097, -0.085)
    else if s == 2
        c := array.from(-8.532, -3.208, 7.917, 1.277, -1.097, 0.847, 0.016, 1.614, -0.117)
    else if s == 3 and up
        c := array.from(-10.169, -3.56, 8.067, 1.468, -0.255, 0.132, 0.085, 0.934, -0.077)
    else if s == 3
        c := array.from(-9.86, -3.38, 7.298, 0.92, 0.634, 0.883, 0.152, 0.727, 0.211)
    c
f_lvProb(array<float> c, float dist, float beyond, float left, float rngN, float ret, float side) =>
    float ld = math.log(math.max(dist, 0) + 0.01)
    float sq = math.sqrt(math.max(left, 0) / 120.0)
    float z = array.get(c, 0) + array.get(c, 1) * ld + array.get(c, 2) * sq + array.get(c, 3) * ld * sq + array.get(c, 4) * rngN + array.get(c, 5) * ret + array.get(c, 6) * side + array.get(c, 7) * math.log(rngN + 0.02) + array.get(c, 8) * math.log(math.max(beyond, 0) + 0.01)
    1.0 / (1.0 + math.exp(-z))
var array<float> LVU = f_lvCoef(S, true)
var array<float> LVD = f_lvCoef(S, false)
f_liveLevels(float lft, float rN, float sdM) =>
    int n = array.size(tLbQ)
    if n > 0
        for i = 0 to n - 1
            label lb = array.get(tLbQ, i)
            string tx = label.get_text(lb)
            if label.get_x(lb) > time and (str.startswith(tx, "ONH") or str.startswith(tx, "ONL") or str.startswith(tx, "PD") or str.startswith(tx, "PW") or str.startswith(tx, "GAP "))
                float lv = label.get_y(lb)
                string nm = array.get(str.split(tx, " "), 0)
                if lv > amHi
                    float pu = f_lvProb(LVU, (lv - close) / dHar, (lv - amHi) / dHar, lft, rN, (close - o930) / dHar, sdM)
                    label.set_text(lb, nm + " " + str.tostring(math.round(pu * 100)) + "%")
                else if lv < amLo
                    float pd = f_lvProb(LVD, (close - lv) / dHar, (amLo - lv) / dHar, lft, rN, (o930 - close) / dHar, -sdM)
                    label.set_text(lb, nm + " " + str.tostring(math.round(pd * 100)) + "%")
    true
// ─────────────────────────────────────────────────────────── likely AM high / low zones (drawn at 9:30)
// Where the 9:30-11:30 high and low land from the 9:30 open (x daily HAR), middle 50% and median, by overnight-range tercile
// (Expect-row cuts). Bands fitted 2010-18 held 45-56% of 2019-26 days (target 50%). Layout per tercile: H25 H50 H75 L25 L50 L75.
f_amZone(int s) =>
    array<float> a = array.new<float>()
    if s == 0
