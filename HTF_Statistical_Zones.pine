        array.push(tLQ, line.new(time + tOff, o830, t1130d, o830, xloc = xloc.bar_time, color = color.new(tagCol, p83 >= 50 ? 15 : 50), style = f_ls(tagStyle), width = tagW))
        array.push(tLbQ, label.new(t1130d, o830, "8:30 open " + str.tostring(p83) + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Chance price trades back to the 8:30 open between 9:30 and 11:30, given its distance from the 9:30 open (Databento 1m; 2010-18, 2019-22 and 2023-26 within ~9 points)." + (S == 0 or S == 2 ? " NQ/YM: on the first touch after 9:35, price ran 0.1x the daily range through it before coming back 0.1x on 56-62% of days (every era; fake levels nearby: 3-10 pts less) - a level to trade through, not fade." : "")))
