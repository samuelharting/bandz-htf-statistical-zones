        2 => array.from(1.4750, 1.1990, 0.7740)
        3 => array.from(2.3330, 1.4520, 1.0000)

f_or15_ft(int s) =>
    switch s
        0 => array.from(0.4910, 0.5200, 0.5490)
        1 => array.from(0.4980, 0.5050, 0.5170)
        2 => array.from(0.5020, 0.5400, 0.5340)
        3 => array.from(0.5720, 0.5430, 0.5550)

f_or30_cut(int s) =>
    switch s
        0 => array.from(0.2817, 0.3937)
        1 => array.from(0.2405, 0.3385)
        2 => array.from(0.2658, 0.3786)
        3 => array.from(0.1917, 0.2778)

f_or30_u50(int s) =>
    switch s
        0 => array.from(0.2410, 0.1250, 0.0150)
        1 => array.from(0.3070, 0.1670, 0.0570)
        2 => array.from(0.2520, 0.1070, 0.0000)
        3 => array.from(0.3570, 0.1760, 0.0000)

f_or30_u80(int s) =>
    switch s
        0 => array.from(0.8010, 0.6230, 0.4330)
        1 => array.from(0.9300, 0.6740, 0.4800)
        2 => array.from(0.8200, 0.6120, 0.4180)
        3 => array.from(1.2740, 0.8270, 0.4850)

f_or30_d50(int s) =>
    switch s
        0 => array.from(0.1700, 0.0760, 0.0000)
        1 => array.from(0.1780, 0.1420, 0.0490)
        2 => array.from(0.1740, 0.0830, 0.0000)
        3 => array.from(0.3460, 0.1460, 0.0000)

f_or30_d80(int s) =>
    switch s
        0 => array.from(0.8970, 0.6810, 0.5150)
        1 => array.from(0.9440, 0.8520, 0.5730)
        2 => array.from(0.8910, 0.7250, 0.4370)
        3 => array.from(1.2980, 0.9180, 0.5200)

f_or30_ft(int s) =>
    switch s
        0 => array.from(0.5120, 0.5250, 0.5770)
        1 => array.from(0.5140, 0.5300, 0.5090)
        2 => array.from(0.5050, 0.5470, 0.5170)
        3 => array.from(0.5720, 0.5770, 0.6500)


var array<float> BETA  = f_beta(S)
var array<float> DQU   = f_dq_up(S)
var array<float> DQD   = f_dq_dn(S)
var array<float> HQU   = f_h4q_up(S)
var array<float> HQD   = f_h4q_dn(S)
var array<int>   CAL_FOMC = f_cal_FOMC()
var array<int>   CAL_CPI  = f_cal_CPI()
var array<int>   CAL_NFP  = f_cal_NFP()

pctIndex(string p) => p == "50" ? 0 : p == "70" ? 1 : p == "80" ? 2 : p == "90" ? 3 : 4
int iIn  = pctIndex(innerPct)
int iOut = pctIndex(outerPct)
bool twoTier = iIn < 2 and iOut > 2                // shade inner..80 lighter and 80..outer stronger

// colors derived from the two base colors
color upFillIn  = color.new(upBase, 90)
color upFillOut = color.new(upBase, 80)
color dnFillIn  = color.new(dnBase, 90)
color dnFillOut = color.new(dnBase, 80)
color upHot     = color.new(upBase, 68)
color dnHot     = color.new(dnBase, 68)
color upOld     = color.new(upBase, 94)
color dnOld     = color.new(dnBase, 94)
color upEdge    = color.new(upBase, 25)
color dnEdge    = color.new(dnBase, 25)
color txtDim    = color.new(#8b949e, 0)
color txtMain   = color.new(#d0d7de, 0)

// ─────────────────────────────────────────────────────────── helpers
dateInt(int t) => year(t, "UTC") * 10000 + month(t, "UTC") * 100 + dayofmonth(t, "UTC")

evType(int d) =>
    array.includes(CAL_FOMC, d) ? "FOMC" : array.includes(CAL_CPI, d) ? "CPI" : array.includes(CAL_NFP, d) ? "NFP" : ""

evTime(string e) => e == "FOMC" ? "2:00" : "8:30"

dayName(int t) =>
    int dw = dayofweek(t, "UTC")
    dw == dayofweek.monday ? "Mon" : dw == dayofweek.tuesday ? "Tue" : dw == dayofweek.wednesday ? "Wed" : dw == dayofweek.thursday ? "Thu" : "Fri"

// next weekday after the trading date t (UTC midnight)
nextWeekday(int t) =>
    int dw = dayofweek(t, "UTC")
    t + (dw == dayofweek.friday ? 3 : dw == dayofweek.saturday ? 2 : 1) * 86400000

fmtP(float p) => na(p) ? "–" : str.tostring(math.round(p * 100)) + "%"
fmtPx(float x) => na(x) ? "–" : str.tostring(x, format.mintick)
prng(int a, int b) => a == b ? str.tostring(a) + "%" : str.tostring(a) + "-" + str.tostring(b) + "%"
fmtR(float x) => na(x) ? "–" : x >= 50 ? str.tostring(math.round(x)) : str.tostring(math.round(x / syminfo.mintick) * syminfo.mintick, "#,##0.##")
fmtPts(float x) => na(x) ? "–" : str.tostring(math.round(x / syminfo.mintick) * syminfo.mintick, "#,##0.##")

// ─────────────────────────────────────────────────────────── higher-timeframe data (non-repainting)
// Back-adjusted extended-session series so prior-week / 20-day levels are comparable to today's contract.
string tid = ticker.new(syminfo.prefix, syminfo.ticker, session.extended, backadjustment = backadjustment.on, settlement_as_close = settlement_as_close.on)

// Every value below uses only completed daily bars ([1] or older) plus state from earlier days,
// so lookahead_on cannot leak future data.
f_daily() =>
    float r = high - low
    float har = (r[1] + ta.sma(r, 5)[1] + ta.sma(r, 22)[1]) / 3.0
    float prevRatio = r[1] / har[1]
    float clv = (close[1] - low[1]) / math.max(high[1] - low[1], syminfo.mintick)
    float hi20 = ta.highest(high, 20)[1]
    float lo20 = ta.lowest(low, 20)[1]
    float vp = ta.percentrank(har / close[1], 250) / 100.0
    float s20 = ta.sma(close, 20)[1]
    float s50 = ta.sma(close, 50)[1]
    float s200 = ta.sma(close, 200)[1]
    float pdDir = math.sign(close[1] - open[1])
    float vote = math.sign(math.sign(close[1] - close[43]) + math.sign(close[1] - close[16]) + math.sign(close[1] - close[4]))
    var float wh = na
    var float wl = na
    bool nw = timeframe.change("W")
    float sfH = nw ? na : wh
    float sfL = nw ? na : wl
    wh := nw ? high : math.max(wh, high)
    wl := nw ? low : math.min(wl, low)
    [har, prevRatio, clv, hi20, lo20, vp, sfH, sfL, s20, s50, s200, vote, pdDir, high[1], low[1]]

f_week() =>
    float r = high - low
    [(r[1] + ta.sma(r, 4)[1] + ta.sma(r, 13)[1]) / 3.0, high[1], low[1], open]

f_month() =>
    float r = high - low
    [(r[1] + ta.sma(r, 3)[1] + ta.sma(r, 6)[1]) / 3.0, open]

// 4H blocks by NY hour: 0=18-22 1=22-02 2=02-06 3=06-10 4=10-14 5=14-17. Scale per block =
// (last range + mean of last 5 + mean of last 20 ranges of the same block), from completed blocks only.
f_blocks() =>
    int blk = int(math.floor(((hour(time, "America/New_York") - 18 + 24) % 24) / 4))
    var float bh = na
    var float bl = na
    var int cb = -1
    var array<float> hist = array.new<float>(120, na)
    if blk != cb
        if cb >= 0 and not na(bh)
            array.insert(hist, cb * 20, bh - bl)
            array.remove(hist, cb * 20 + 20)
        cb := blk
        bh := high
        bl := low
    else
        bh := math.max(bh, high)
        bl := math.min(bl, low)
    float s5 = 0.0
    float s20 = 0.0
    int n5 = 0
    int n20 = 0
    for i = 0 to 19
        float v = array.get(hist, blk * 20 + i)
        if not na(v)
            if i < 5
                s5 += v
                n5 += 1
            s20 += v
            n20 += 1
    float r0 = array.get(hist, blk * 20)
    float sc = n20 >= 5 and not na(r0) ? (r0 + s5 / n5 + s20 / n20) / 3.0 : na
    [sc, blk]

// 9:30-9:45 volume relative to its own 20-day average, in the 15m context (value available when the bar closes)

[dHar, dPrevRatio, dClv, dHi20, dLo20, dVolP, dSfH, dSfL, dS20, dS50, dS200, dVote, dPdDir, dPdH, dPdL] = request.security(tid, "D", f_daily(), lookahead = barmerge.lookahead_on)
float dOpenHTF = request.security(tid, "D", open, lookahead = barmerge.lookahead_on)
[dH2, dL2] = request.security(tid, "D", [high[2], low[2]], lookahead = barmerge.lookahead_on)
[wSig, pwh, pwl, wOpenHTF] = request.security(tid, "W", f_week(), lookahead = barmerge.lookahead_on)
[mSig, mOpenHTF] = request.security(tid, "M", f_month(), lookahead = barmerge.lookahead_on)
// Implied vol: read ONLY on the first bar of the futures day (18:00 NY), when the latest index bar is the
// previous session's completed bar. Later in the day this value is never used.
float ivClose = request.security(ivSym, "D", close, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[hScale, hBlk] = request.security(tid, "60", f_blocks(), lookahead = barmerge.lookahead_on)

// ─────────────────────────────────────────────────────────── futures-day state
bool intraday = timeframe.isintraday
int  tday = time_tradingday
int  tdChg = ta.change(tday)
bool newDay = intraday and tdChg != 0
int  nyHour = hour(time, "America/New_York")
int  nyMin  = minute(time, "America/New_York")
int  barMs  = timeframe.in_seconds() * 1000
int  tOff   = tgtOffB * barMs
int  tLen   = tgtLenB * barMs

var int    prevDate = na
var int    monthCount = 0
var int    lastMonth = na
var float  dOpen = na
var float  sigma = na
var float  ctxMult = na
var string ctxText = ""
var string newsTxt = ""
var bool   newsIsToday = false
var bool   newsAhead = false
var bool   ivUsed = false
var float  dayHi = na
var float  dayLo = na
var int    dayStart = na
var int    dayEnd = na
var float  uIn = na
var float  uOut = na
var float  lIn = na
var float  lOut = na
var int    bias = 0
var int    monDir = 0
var float  monH = na
var float  monL = na
var string biasWhy = "trend"
var string biasPct = "53-55%"
var bool   upTouched = false
var bool   dnTouched = false
var array<float> feat = array.new<float>(20, 0.0)
// drawings: today's handles + history queues
var box upBoxIn = na
var box upBoxOut = na
var box dnBoxIn = na
var box dnBoxOut = na
var array<box>   hBoxQ = array.new<box>()
var array<line>  hLineQ = array.new<line>()
var array<label> hLblQ = array.new<label>()


if newDay
    int dd = dateInt(tday)
    int y = year(tday, "UTC")
    int mo = month(tday, "UTC")
    int dom = dayofmonth(tday, "UTC")
    int dw = dayofweek(tday, "UTC")
    dayStart := time
    dayEnd := timestamp("America/New_York", y, mo, dom, 17, 0)
    dOpen := na(dOpenHTF) ? open : dOpenHTF
    // trading-day count within the month and weekdays left after today
    monthCount := na(lastMonth) or mo != lastMonth ? 1 : monthCount + 1
    lastMonth := mo
    int dim = mo == 2 ? (y % 4 == 0 and (y % 100 != 0 or y % 400 == 0) ? 29 : 28) : (mo == 4 or mo == 6 or mo == 9 or mo == 11) ? 30 : 31
    int left = 0
    if dom < dim                                  // Pine for-loops count down when start > end
        for k = dom + 1 to dim
            int wd = dayofweek(timestamp("UTC", y, mo, k, 0, 0), "UTC")
            if wd != dayofweek.saturday and wd != dayofweek.sunday
                left += 1
    // news with the research priority FOMC > CPI > NFP; today > tomorrow > yesterday
    string evT = evType(dd)
    int tmr = nextWeekday(tday)
    string evN = evType(dateInt(tmr))
    string evY = na(prevDate) ? "" : evType(prevDate)
    string later = ""
    int scan = nextWeekday(tmr)
    for k = 0 to 3
        if dayofweek(scan, "UTC") == dayofweek.monday
            break
        string e = evType(dateInt(scan))
        if e != ""
            later := later + (later == "" ? "" : ", ") + e + " " + dayName(scan)
        scan := nextWeekday(scan)
    newsIsToday := evT != ""
    newsAhead := evT != "" or evN != "" or later != ""
    newsTxt := evT != "" ? evT + " today " + evTime(evT) : ""
    if evN != ""
        newsTxt := newsTxt + (newsTxt == "" ? "" : " · ") + evN + " " + (dw == dayofweek.friday ? "Mon" : "tmrw") + " " + evTime(evN)
    if later != ""
        newsTxt := newsTxt + (newsTxt == "" ? "" : " · ") + later
    bool afterF = evT == "" and evN == "" and evY == "FOMC"
    bool afterN = evT == "" and evN == "" and evY == "NFP"
    prevDate := dd
    // context features (order fixed by gen_constants.py)
    float p20 = (dOpen - dLo20) / math.max(dHi20 - dLo20, syminfo.mintick)
    float mid = (pwh + pwl) / 2.0
    array.set(feat, 0, dPrevRatio > 1.3 ? 1.0 : 0.0)
    array.set(feat, 1, dPrevRatio < 0.7 ? 1.0 : 0.0)
    array.set(feat, 2, dClv > 0.8 ? 1.0 : 0.0)
    array.set(feat, 3, dClv < 0.2 ? 1.0 : 0.0)
    array.set(feat, 4, dOpen > pwh ? 1.0 : 0.0)
    array.set(feat, 5, dOpen < pwl ? 1.0 : 0.0)
    array.set(feat, 6, dOpen >= pwl and dOpen < mid ? 1.0 : 0.0)
    array.set(feat, 7, p20 >= 0.8 ? 1.0 : 0.0)
    array.set(feat, 8, p20 < 0.2 ? 1.0 : 0.0)
    array.set(feat, 9, dVolP > 0.67 ? 1.0 : 0.0)
    array.set(feat, 10, dVolP < 0.33 ? 1.0 : 0.0)
    array.set(feat, 11, evT == "FOMC" ? 1.0 : 0.0)
    array.set(feat, 12, evT == "NFP" ? 1.0 : 0.0)
    array.set(feat, 13, evT == "CPI" ? 1.0 : 0.0)
    array.set(feat, 14, afterF ? 1.0 : 0.0)
    array.set(feat, 15, afterN ? 1.0 : 0.0)
    array.set(feat, 16, monthCount <= 3 ? 1.0 : 0.0)
    array.set(feat, 17, left <= 1 ? 1.0 : 0.0)
    array.set(feat, 18, dw == dayofweek.monday ? 1.0 : 0.0)
    array.set(feat, 19, dw == dayofweek.friday and dom >= 15 and dom <= 21 ? 1.0 : 0.0)
    float xb = 0.0
    for k = 0 to 19
        xb += array.get(feat, k) * array.get(BETA, k)
    ctxMult := math.exp(xb)
    float ivMove = na(ivClose) ? na : ivClose / 100.0 / math.sqrt(252.0) * dOpen
    ivUsed := blendScale and not na(ivMove)
    float baseSc = ivUsed ? math.sqrt(dHar * ivMove) : dHar
    sigma := baseSc * ctxMult
    // readable context summary (table tooltip)
    string c = ""
    c += dPrevRatio > 1.3 ? "• after an expansion day\n" : dPrevRatio < 0.7 ? "• after a quiet day\n" : ""
    c += dClv > 0.8 ? "• prior close near its high\n" : dClv < 0.2 ? "• prior close near its low\n" : ""
    c += dOpen > pwh ? "• open above last week's high\n" : dOpen < pwl ? "• open below last week's low\n" : dOpen < mid ? "• open in lower half of last week\n" : ""
    c += p20 >= 0.8 ? "• top of the 20-day range\n" : p20 < 0.2 ? "• bottom of the 20-day range\n" : ""
    c += dVolP > 0.67 ? "• high-volatility regime\n" : dVolP < 0.33 ? "• low-volatility regime\n" : ""
    c += evT != "" ? "• " + evT + " today\n" : afterF ? "• day after FOMC\n" : afterN ? "• day after NFP\n" : ""
    c += monthCount <= 3 ? "• first days of the month\n" : left <= 1 ? "• last days of the month\n" : ""
    c += dw == dayofweek.monday ? "• Monday\n" : ""
    ctxText := (c == "" ? "• nothing unusual\n" : c) + "Context multiplier x" + str.tostring(ctxMult, "#.##") + (ivUsed ? " · scale = HAR x implied vol" : " · scale = HAR range")
    // daily bias: trend filter, the only rule that held up 2001-2026 (direction hit ~53-55% equities, ~52-53% gold)
    // trend rule, full futures day (18:00 -> close), Databento 2010-26: NQ 55.7/54.7%, ES 54.3/54.9%, YM 55.3/52.5%;
    // gold 49-50% (no edge -> neutral). For 9:30-11:30 only it is weaker (51-55%).
    // audit 2026-10-05: the trend rule's LONG calls (53-59%) only matched the index drift (all days up 53-56%) and its
    // SHORT calls were right 12-52% -> no day call by default
    bias := 0
    biasWhy := ""
    biasPct := ""
    // Monday's direction for the weekly hint (Yahoo daily 2001-26, both eras): Monday up -> its low is the week
    // low 41-46% (base ~20%); Monday down -> its high is the week high 29-38%.
    if dw == dayofweek.monday
        monDir := 0
    else if dw == dayofweek.tuesday
        monDir := int(dPdDir)
        monH := dPdH
        monL := dPdL
    // tested overrides (Databento 2010-26, >=56% in both eras, n>=150 each)
    if S == 0 and dw == dayofweek.monday
        bias := 1
        biasWhy := "NQ Monday"
        biasPct := "59-63%"
    // "NQ fade a big day" removed 2026-10-05 audit: 54.9/54.5% (below the bar)
    // YM quiet day + above its 20-day average: up 62/57/57% (short side 44-67%, dropped)
    else if S == 2 and dPrevRatio < 0.7 and dOpen > dS20
        bias := 1
        biasWhy := "quiet day + above 20d avg"
        biasPct := "57-62%"
    dayHi := high
    dayLo := low
    upTouched := false
    dnTouched := false
    uIn := na
    uOut := na
    lIn := na
    lOut := na

    // ── fade yesterday, draw today's fixed zones
    if not na(upBoxIn)
        box.set_bgcolor(upBoxIn, upOld)
        box.set_bgcolor(dnBoxIn, dnOld)
    if not na(upBoxOut)
        box.set_bgcolor(upBoxOut, upOld)
        box.set_bgcolor(dnBoxOut, dnOld)
    if showDaily and not na(sigma)
        uIn := dOpen + array.get(DQU, iIn) * sigma
        uOut := dOpen + array.get(DQU, iOut) * sigma
        lIn := dOpen - array.get(DQD, iIn) * sigma
        lOut := dOpen - array.get(DQD, iOut) * sigma
        float uMid = dOpen + array.get(DQU, 2) * sigma
        float lMid = dOpen - array.get(DQD, 2) * sigma
        upBoxIn := twoTier ? box.new(dayStart, uMid, dayEnd, uIn, xloc = xloc.bar_time, border_width = 0, bgcolor = upFillIn) : na
        upBoxOut := box.new(dayStart, uOut, dayEnd, twoTier ? uMid : uIn, xloc = xloc.bar_time, border_width = 0, bgcolor = upFillOut)
        if biasMode and bias != 0
            array.push(hLblQ, label.new(dayStart, bias == 1 ? lIn : uIn, (bias == 1 ? "LONG " : "SHORT ") + biasPct, xloc = xloc.bar_time, style = bias == 1 ? label.style_label_up : label.style_label_down, color = color.new(bias == 1 ? dnBase : upBase, 15), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Trend bias locked at the 18:00 open: 50d avg vs 200d avg and open vs 20d avg. Right on the full-day direction (18:00 to close) " + biasPct + " since 2010 (both eras); weaker for 9:30-11:30 alone (51-55%). Gold: no edge, so no trend bias. A lean, not a signal."))
        dnBoxIn := twoTier ? box.new(dayStart, lIn, dayEnd, lMid, xloc = xloc.bar_time, border_width = 0, bgcolor = dnFillIn) : na
        dnBoxOut := box.new(dayStart, twoTier ? lMid : lIn, dayEnd, lOut, xloc = xloc.bar_time, border_width = 0, bgcolor = dnFillOut)
        array.push(hBoxQ, upBoxIn)
        array.push(hBoxQ, upBoxOut)
        array.push(hBoxQ, dnBoxIn)
        array.push(hBoxQ, dnBoxOut)
        array.push(hLineQ, line.new(dayStart, uOut, dayEnd, uOut, xloc = xloc.bar_time, color = upEdge, width = zoneW))
        array.push(hLineQ, line.new(dayStart, lOut, dayEnd, lOut, xloc = xloc.bar_time, color = dnEdge, width = zoneW))
        if showOpen
            array.push(hLineQ, line.new(dayStart, dOpen, dayEnd, dOpen, xloc = xloc.bar_time, color = openCol, style = f_ls(openStyle)))
        if showDLbl
            string tipU = "Day high stayed below this line on " + outerPct + "% of days (context-adjusted)."
            string tipD = "Day low stayed above this line on " + outerPct + "% of days (context-adjusted)."
            array.push(hLblQ, label.new(dayEnd, uOut, outerPct + "%  " + fmtPx(uOut), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = tipU))
            array.push(hLblQ, label.new(dayEnd, uIn, innerPct + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny))
            array.push(hLblQ, label.new(dayEnd, lIn, innerPct + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny))
            array.push(hLblQ, label.new(dayEnd, lOut, outerPct + "%  " + fmtPx(lOut), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = tipD))
        // keep only the last N days
        while array.size(hBoxQ) > daysBack * 4
            box.delete(array.shift(hBoxQ))
        while array.size(hLineQ) > daysBack * (showOpen ? 3 : 2)
            line.delete(array.shift(hLineQ))
        while array.size(hLblQ) > daysBack * 5
            label.delete(array.shift(hLblQ))
else if intraday
    dayHi := math.max(dayHi, high)
    dayLo := math.min(dayLo, low)

// zones brighten once price trades into them
if not na(uIn) and not upTouched and dayHi >= uIn
    upTouched := true
    box.set_bgcolor(upBoxOut, upHot)
    if not na(upBoxIn)
        box.set_bgcolor(upBoxIn, color.new(upBase, 82))
if not na(lIn) and not dnTouched and dayLo <= lIn
    dnTouched := true
    box.set_bgcolor(dnBoxOut, dnHot)
    if not na(dnBoxIn)
        box.set_bgcolor(dnBoxIn, color.new(dnBase, 82))
// invisible plots so auto-scale includes the zones (today only)
bool fitIn = fitMode != "Off" and intraday and time >= dayStart
bool fitOut = fitMode == "Full zones" and intraday and time >= dayStart
plot(fitIn ? uIn : na, "fit upper", color.new(color.black, 100), display = display.pane, editable = false)
plot(fitIn ? lIn : na, "fit lower", color.new(color.black, 100), display = display.pane, editable = false)
plot(fitOut ? uOut : na, "fit upper outer", color.new(color.black, 100), display = display.pane, editable = false)
plot(fitOut ? lOut : na, "fit lower outer", color.new(color.black, 100), display = display.pane, editable = false)
// tested: upper zone first hit between 9:00 and 11:59 NY -> NQ/ES kept going 56-65% in both eras (2010-26, 1m)
// audit 2026-10-05 (70% line, +/-0.2x race): NQ 59.0/53.0%, ES 57.3/55.0% -> fails 2019-26, claim removed (alerts kept)

var float pdH = na
var float pdL = na
var float tdH = na
var float tdL = na
var float onH = na
var float onL = na
var float c16 = na
var float c16prev = na

// ─────────────────────────────────────────────────────────── overnight 4H candles (18-22, 22-02, 02-06) for the AM bias
var float h4o = na
var int h4a = 0
var int h4b = 0
var int h4c = 0
var float o930 = na
if newDay
    h4o := open
    h4a := 0
    h4b := 0
    h4c := 0
if intraday and nyHour != nz(nyHour[1]) and (nyHour == 22 or nyHour == 2 or nyHour == 6)
    int dirC = close[1] > h4o ? 1 : close[1] < h4o ? -1 : 0
    if nyHour == 22
        h4a := dirC
    else if nyHour == 2
        h4b := dirC
    else
        h4c := dirC
    h4o := open
int h4agree = h4a != 0 and h4a == h4b and h4b == h4c ? h4a : 0

// ─────────────────────────────────────────────────────────── session boxes (16-year sizes, fixed at each start)
var array<box> sQ = array.new<box>()
var array<label> sL = array.new<label>()
var string sessTxt = ""
var color sessC = color.gray
int nyT = nyHour * 60 + nyMin
int nyTprev = nz(nyHour[1]) * 60 + nz(nyMin[1])
startOf(int sMin) => intraday and timeframe.in_seconds() <= 1800 and nyT >= sMin and (nyTprev < sMin or nyTprev > nyT)

// q = [u70, u90, d70, d90] in units of the daily HAR range (Databento 2010-2026)
drawSess(string nm, int eMin, array<float> q, int b, string why) =>
    float sc = dHar * (na(ctxMult) ? 1.0 : ctxMult)
    float o = open
    int tE = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), int(math.floor(eMin / 60)), eMin % 60)
    box bu = box.new(time, o + array.get(q, 1) * sc, tE, o + array.get(q, 0) * sc, xloc = xloc.bar_time, border_color = color.new(sessCol, 35), border_width = 1, bgcolor = color.new(sessCol, b == 1 ? 88 : 96))
    box bd = box.new(time, o - array.get(q, 2) * sc, tE, o - array.get(q, 3) * sc, xloc = xloc.bar_time, border_color = color.new(sessCol, 35), border_width = 1, bgcolor = color.new(sessCol, b == -1 ? 88 : 96))
    string arrow = b == 1 ? "▲" : b == -1 ? "▼" : ""
    string tip = nm + " box: on 70-90% of sessions since 2010 the " + nm + " high/low stayed inside these distances from the session open (Databento 1m, scaled to the daily range and today's context).\n" + why
    label lb = b == 0 ? na : label.new(time, b == -1 ? o - array.get(q, 3) * sc : o + array.get(q, 1) * sc, nm + " " + arrow, xloc = xloc.bar_time, style = b == -1 ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = tip)
    [bu, bd, lb]

var array<line> amEdgeQ = array.new<line>()
var float onUsed930 = na
var int amBias = 0
if newDay
    amBias := 0
if intraday and startOf(570)
    o930 := open
    onUsed930 := na(onH) or na(dHar) ? na : (onH - onL) / dHar
if not na(dHar)
    if showW1 and startOf(570)
        // AM: all three overnight 4H candles agree -> lean that way (NQ/ES/YM held 53-56% after 9:45, 2010-26; not gold)
        // gold instead: a big move since 18:00 (>0.8x daily range) kept going 9:30-11:30 55% / 55.5% (n=225/218)
        float s18 = na(dOpen) ? 0.0 : (open - dOpen) / dHar
        // audit 2026-10-05: "all overnight 4H agree" as an AM (9:30-11:30) bias was 46-55% for the index futures -> removed
        int b = S != 3 ? 0 : math.abs(s18) > 0.8 ? int(math.sign(s18)) : 0
        // Monday after Friday closed in its upper half (rechecked 2026-10-05: 56-64%, n 88-111/era) and 9:30 above the 18:00 open -> AM up NQ 60/60%, ES 60/57%, YM 66/60% (n~120/era each)
        // removed 2026-10-05: 2023-26 only 41-48% (pooled ~45%, n~130) on NQ/ES/YM - the edge faded recently
        bool monUp = false
        if monUp
            b := 1
        // NQ on monthly OPEX Friday: 9:30-11:30 closed down 56% / 61% (n=100/90)
        bool opexDn = S == 0 and dayofweek(time, "America/New_York") == dayofweek.friday and dayofmonth(time, "America/New_York") >= 15 and dayofmonth(time, "America/New_York") <= 21
        if opexDn
            b := -1
        // Monday after monthly OPEX: 9:30-11:30 up NQ 60/57%, ES 56/59%, YM 58/57% (n~100/93 per era)
        bool opexMon = S != 3 and dayofweek(time, "America/New_York") == dayofweek.monday and dayofmonth(time, "America/New_York") >= 18 and dayofmonth(time, "America/New_York") <= 24
        if opexMon
            b := 1
        string why = opexMon ? "Bias: Monday after monthly options expiry; the 9:30-11:30 closed up 56-60% of such Mondays (NQ/ES/YM, both 2010-18 and 2019-26)." : opexDn ? "Bias: monthly options-expiry Friday; NQ's 9:30-11:30 closed down 56% (2010-18) / 61% (2019-26), and 9:30-10:00 down 59-62%." : monUp ? "Bias: Monday, Friday closed in its upper half and 9:30 is above the 18:00 open; the AM went up 56-63% of such Mondays (NQ/ES/YM, both 2010-18 and 2019-26)." : S == 3 ? (b != 0 ? "Bias: gold already moved " + str.tostring(math.abs(s18), "#.##") + "x its daily range since 18:00; big overnight moves kept going into 11:30 55% of the time (2010-26)." : "No tested AM edge today (gold needs a move >0.8x the daily range since 18:00).") : "No tested AM edge today (calendar rules only: OPEX Friday, Monday after OPEX, Monday after a strong Friday)."
        [bu, bd, lb] = drawSess("AM", 690, f_ss_am(S), b, why)
        // merged with the blue "likely AM high / low" zones: the yellow AM box is hidden and only its outer (90%) edge is
        // drawn as a line (a zero-height box does not render)
        for bx in array.from(bu, bd)
            box.set_bgcolor(bx, color.new(sessCol, 100))
            box.set_border_color(bx, color.new(sessCol, 100))
        array.push(sQ, bu)
        array.push(sQ, bd)
        array.push(sL, lb)
        sessTxt := b == 0 ? "AM · no edge" : (b == 1 ? "AM ▲ " : "AM ▼ ") + (opexMon ? "Mon after OPEX (56-60%)" : opexDn ? "OPEX Friday (56-61%)" : monUp ? "Mon after strong Fri (57-66%)" : S == 3 ? "big overnight move (55%)" : "4H aligned (53-56%)")
        sessC := b == 1 ? color.new(dnBase, 0) : b == -1 ? color.new(upBase, 0) : txtDim
        amBias := b
    // 10:00 check of the AM bias (NQ/ES): 9:30-10:00 went with it -> 10:00-11:30 kept going NQ 56/59%, ES 54/58%
    // (n 320-410/era); went against it -> coin flip after 10:00 (45-52%). YM: no difference, not shown.
    if (S == 0 or S == 1) and amBias != 0 and intraday and nyT >= 600 and nyTprev < 600 and not na(o930)
        int e10 = close[1] > o930 ? 1 : close[1] < o930 ? -1 : 0
        if e10 == amBias and S == 0
            sessTxt := sessTxt + " · on track (57-59% after 10)"
        else if e10 != 0
            sessTxt := (amBias == 1 ? "AM ▲" : "AM ▼") + " off track · coin flip after 10:00"
            sessC := txtDim
    if showW2 and startOf(690)
        // Midday: NQ only, 9:30 open above prior-day high -> midday up 56% in both eras
        // NQ: 9:30 open above PDH -> midday up 58/59% (n~400/era); plus green 9:30-9:45 candle -> 64/63% (n~190-200)
        bool aboveP = S == 0 and not na(o930) and not na(pdH) and o930 > pdH
        int b = aboveP ? 1 : 0
        string why = aboveP ? "Bias: 9:30 opened above yesterday's high; NQ midday went up 57.5% / 58.8% of such days (2010-18 / 2019-26)." : "No tested midday edge today."
        [bu, bd, lb] = drawSess("Mid", 810, f_ss_mid(S), b, why)
        array.push(sQ, bu)
        array.push(sQ, bd)
        array.push(sL, lb)
        sessTxt := b == 1 ? "Mid ▲ above PDH (57-59%)" : "Mid · no edge"
        sessC := b == 1 ? color.new(dnBase, 0) : txtDim
    if showW3 and startOf(810)
        // NQ/YM: big overnight range (top third) + 9:30 open above PDH -> PM up 58-61% (both eras, n~160/era)
        // ES: Friday, gap direction agrees with the 2m/3w/3d vote -> PM that way 62% / 59% (n~220/era)
        float cutOn = S == 0 ? 0.612 : S == 2 ? 0.646 : 9.0
        bool bigOnAbove = (S == 0 or S == 2) and not na(onUsed930) and onUsed930 > cutOn and not na(o930) and not na(pdH) and o930 > pdH
        int gapD = na(c16prev) or na(o930) ? 0 : o930 > c16prev ? 1 : -1
        bool esFri = S == 1 and dayofweek(time_tradingday, "UTC") == dayofweek.friday and gapD != 0 and gapD == dVote
        int b = bigOnAbove ? 1 : esFri ? gapD : 0
        string why = bigOnAbove ? "Bias: big overnight range and 9:30 opened above yesterday's high; PM went up 57-61% of such days (NQ 58/61%, YM 57/58%, both eras)." : esFri ? "Bias: Friday, gap direction matches the 2-month/3-week/3-day trend vote; ES PM went that way 61% / 58% (2010-18 / 2019-26)." : "No tested PM edge today."
        [bu, bd, lb] = drawSess("PM", 960, f_ss_pm(S), b, why)
        array.push(sQ, bu)
        array.push(sQ, bd)
        array.push(sL, lb)
        sessTxt := b == 0 ? "PM · no edge" : (b == 1 ? "PM ▲ " : "PM ▼ ") + (esFri ? "Fri gap + trend (58-61%)" : "big ON + above PDH (57-61%)")
        sessC := b == 1 ? color.new(dnBase, 0) : b == -1 ? color.new(upBase, 0) : txtDim
    while array.size(sQ) > sessDays * 6
        box.delete(array.shift(sQ))
    while array.size(sL) > sessDays * 3
        label.delete(array.shift(sL))
if newDay
    sessTxt := ""
    o930 := na

// 9:30 opened beyond the 70% / 80% day-zone line (Databento 2010-26, all 4 markets, both eras): next zone line out
// reached by 11:30 73-86% (from 70-80) / 59-78% (from 80-90); back to the 18:00 open only 2-10%. 90%+: too few days.
var string zoneTxt = ""
if newDay
    zoneTxt := ""
if intraday and startOf(570) and not na(sigma) and not na(dOpen)
    float zu = (open - dOpen) / sigma
    float zd = (dOpen - open) / sigma
    if zu >= array.get(DQU, 1) and zu < array.get(DQU, 2)
        zoneTxt := "▲ opened past 70%: 80% line by 11:30 73-86% · back to 18:00 open <10%"
    else if zu >= array.get(DQU, 2) and zu < array.get(DQU, 3)
        zoneTxt := "▲ opened past 80%: 90% line by 11:30 59-78% · back to 18:00 open <10%"
    else if zd >= array.get(DQD, 1) and zd < array.get(DQD, 2)
        zoneTxt := "▼ opened past 70%: 80% line by 11:30 73-86% · back to 18:00 open <10%"
    else if zd >= array.get(DQD, 2) and zd < array.get(DQD, 3)
        zoneTxt := "▼ opened past 80%: 90% line by 11:30 59-78% · back to 18:00 open <10%"
// zone time stop: opened past 70% but the 80% line not reached by 10:30 -> by 11:30 only ~20% (pooled 4 markets, 22% / 20%, n ~130/era)
var float zoneLine = na
var int zoneSide = 0
var bool zoneHit = false
if intraday and startOf(570)
    zoneLine := na
    zoneSide := 0
    zoneHit := false
    if not na(sigma) and not na(dOpen)
        float zu2 = (open - dOpen) / sigma
        float zd2 = (dOpen - open) / sigma
        if zu2 >= array.get(DQU, 1) and zu2 < array.get(DQU, 2)
            zoneSide := 1
            zoneLine := dOpen + array.get(DQU, 2) * sigma
        else if zd2 >= array.get(DQD, 1) and zd2 < array.get(DQD, 2)
            zoneSide := -1
            zoneLine := dOpen - array.get(DQD, 2) * sigma
if zoneSide != 0 and nyT >= 570 and nyT < 630 and not na(zoneLine) and (zoneSide == 1 ? high >= zoneLine : low <= zoneLine)
    zoneHit := true
bool zoneStall = intraday and zoneSide != 0 and nyT >= 630 and nyTprev < 630 and not zoneHit and zoneTxt != ""
if zoneStall
    zoneTxt := (zoneSide == 1 ? "▲" : "▼") + " opened past 70% · 80% line not hit by 10:30 -> ~20% by 11:30"
if intraday and nyT >= 690 and nyTprev < 690
    zoneTxt := ""

// 8:30-9:29 range (news reaction) for CPI/NFP mornings
var float r830H = na
var float r830L = na
var float r820H = na
var float r820L = na
var float r800H = na
var float r800L = na
if intraday and startOf(480)
    r800H := high
    r800L := low
else if intraday and nyT > 480 and nyT < 570 and not na(r800H)
    r800H := math.max(r800H, high)
    r800L := math.min(r800L, low)
if intraday and startOf(500)
    r820H := high
    r820L := low
else if intraday and nyT > 500 and nyT < 570 and not na(r820H)
    r820H := math.max(r820H, high)
    r820L := math.min(r820L, low)
if intraday and startOf(510)
    r830H := high
    r830L := low
else if intraday and nyT > 510 and nyT < 570 and not na(r830H)
    r830H := math.max(r830H, high)
    r830L := math.min(r830L, low)
if newDay
    r830H := na
    r830L := na
    r800H := na
    r800L := na
    r820H := na
    r820L := na

// ─────────────────────────────────────────────────────────── expected 9:30-10:00 range (shown 9:30-10:00)
// Median OR30 width x daily range by overnight-range tercile (quiet / normal / big), stable in both eras;
// CPI/NFP mornings ~1.12x, FOMC mornings ~0.88x.
var string expTxt = ""
var string ewStr = ""
var string expTip = ""
var string awStr = ""
var float f5H = na
var float f5L = na
if newDay
    expTxt := ""
    expTip := ""
if intraday and startOf(570) and not na(dHar) and not na(onUsed930)
    float c1 = S == 0 ? 0.423 : S == 1 ? 0.454 : S == 2 ? 0.445 : 0.581
    float c2 = S == 0 ? 0.612 : S == 1 ? 0.656 : S == 2 ? 0.646 : 0.848
    float mq = S == 0 ? 0.288 : S == 1 ? 0.236 : S == 2 ? 0.278 : 0.195
    float mn = S == 0 ? 0.331 : S == 1 ? 0.289 : S == 2 ? 0.313 : 0.230
    float mb = S == 0 ? 0.386 : S == 1 ? 0.336 : S == 2 ? 0.368 : 0.272
    int tq = onUsed930 < c1 ? 0 : onUsed930 > c2 ? 2 : 1
    float nm = newsIsToday ? (str.contains(newsTxt, "FOMC") ? 0.88 : 1.12) : 1.0
    float ew = (tq == 0 ? mq : tq == 2 ? mb : mn) * nm * dHar
    // median 9:30-11:30 range x daily range by the same overnight tercile (eras within 0.04)
    float aq = S == 0 ? 0.449 : S == 1 ? 0.394 : S == 2 ? 0.436 : 0.357
    float an = S == 0 ? 0.542 : S == 1 ? 0.486 : S == 2 ? 0.491 : 0.414
    float ab = S == 0 ? 0.613 : S == 1 ? 0.573 : S == 2 ? 0.598 : 0.496
    // news mornings: CPI/NFP 1.03-1.16x, FOMC 0.77-0.96x of the normal 9:30-11:30 range (both eras)
    float nmA = newsIsToday ? (str.contains(newsTxt, "FOMC") ? (S == 3 ? 0.94 : 0.86) : 1.08) : 1.0
    // Mondays: 9:30-11:30 range 0.89-0.96x normal on all 4 markets, both eras (gold 9:30-10 also ~0.9x)
    bool isMon = dayofweek(time, "America/New_York") == dayofweek.monday
    // yesterday was an inside day -> 9:30-11:30 range NQ 1.11-1.18x, ES 1.04-1.10x, YM 1.12-1.13x, gold 1.04-1.08x (both eras)
    bool insideY = not na(dH2) and not na(dPdH) and dPdH <= dH2 and dPdL >= dL2
    float insM = insideY ? (S == 0 ? 1.14 : S == 1 ? 1.07 : S == 2 ? 1.12 : 1.06) : 1.0
    float aw = (tq == 0 ? aq : tq == 2 ? ab : an) * nmA * (isMon ? 0.92 : 1.0) * insM * dHar
    // inside day also lifts the 9:30-10:00 range for the index futures: NQ 1.07/1.05, ES 1.08/1.05, YM 1.12/1.07 (gold mixed)
    if insideY and S != 3
        ew := ew * (S == 2 ? 1.09 : 1.06)
    // CPI/NFP mornings: 9:30-11:30 range by the size of the 8:30 reaction (8:30-9:29 range / daily range, terciles),
    // both eras: NQ 0.49/0.61/0.71, ES 0.44/0.54/0.67, YM 0.44/0.56/0.67, gold 0.41/0.50/0.57
    if newsIsToday and not str.contains(newsTxt, "FOMC") and not na(r830H)
        float rxN = (r830H - r830L) / dHar
        float k1 = S == 0 ? 0.274 : S == 1 ? 0.302 : S == 2 ? 0.282 : 0.437
        float k2 = S == 0 ? 0.471 : S == 1 ? 0.504 : S == 2 ? 0.466 : 0.811
        int qN = rxN < k1 ? 0 : rxN > k2 ? 2 : 1
        float mN = S == 0 ? (qN == 0 ? 0.493 : qN == 1 ? 0.612 : 0.707) : S == 1 ? (qN == 0 ? 0.442 : qN == 1 ? 0.542 : 0.671) : S == 2 ? (qN == 0 ? 0.444 : qN == 1 ? 0.558 : 0.67) : (qN == 0 ? 0.41 : qN == 1 ? 0.504 : 0.568)
        aw := mN * dHar
        // 9:30-10:00 range by the same terciles (index futures; gold not monotonic in 2010-18): NQ .33/.36/.42, ES .29/.32/.40, YM .30/.34/.40
        if S != 3
            float eN = S == 0 ? (qN == 0 ? 0.326 : qN == 1 ? 0.359 : 0.416) : S == 1 ? (qN == 0 ? 0.291 : qN == 1 ? 0.319 : 0.395) : (qN == 0 ? 0.298 : qN == 1 ? 0.34 : 0.402)
            ew := eN * dHar
    if isMon and S == 3
        ew := ew * 0.9
    // gold: after a big day (>1.3x) the 9:30-11:30 range was 0.87-0.89x, after a quiet day (<0.7x) 1.08-1.15x (both eras)
    if S == 3 and not na(dPrevRatio)
        aw := aw * (dPrevRatio > 1.3 ? 0.88 : dPrevRatio < 0.7 ? 1.1 : 1.0)
    // index futures, non-news days: 8:00-9:29 range terciles -> 9:30-11:30 range 0.87-0.93x (quiet) / 1.08-1.13x (busy), both eras
    if S != 3 and not newsIsToday and not na(r800H)
        float p8 = (r800H - r800L) / dHar
        float pq1 = S == 0 ? 0.169 : 0.179
        float pq2 = S == 0 ? 0.239 : S == 1 ? 0.261 : 0.26
        aw := aw * (p8 < pq1 ? 0.9 : p8 > pq2 ? 1.1 : 1.0)
        ew := ew * (p8 < pq1 ? 0.9 : p8 > pq2 ? 1.1 : 1.0)
    // gold, non-news days: 8:20-9:29 (COMEX open) range terciles (<0.258 / >0.38 x daily range) -> 9:30-11:30 range 0.88-0.92x / 1.06-1.11x
    if S == 3 and not newsIsToday and not na(r820H)
        float g82 = (r820H - r820L) / dHar
        aw := aw * (g82 < 0.258 ? 0.9 : g82 > 0.38 ? 1.08 : 1.0)
        ew := ew * (g82 < 0.258 ? 0.9 : g82 > 0.38 ? 1.09 : 1.0)
    ewStr := fmtR(ew)
    awStr := fmtR(aw)
    expTxt := "10:00 ~" + fmtR(ew) + " · 11:30 ~" + fmtR(aw) + " (" + (tq == 0 ? "quiet" : tq == 2 ? "big" : "normal") + " ON" + (newsIsToday ? ", news" : "") + (insideY ? ", inside day" : "") + ")"
    // gold: big / normal overnight range and 9:30 in its middle 40% -> 9:30-11:30 stayed inside the overnight range 69-72% / 52-53% (both eras)
    if S == 3 and not na(onH) and not na(onL) and onH > onL
        float onPos = (open - onL) / (onH - onL)
        if onPos > 0.3 and onPos < 0.7 and tq >= 1
            expTxt := expTxt + " · inside ON range to 11:30 " + (tq == 2 ? "69-72%" : "52-53%")
    // monthly OPEX Friday (3rd Friday): 9:30-10:00 closed down NQ 59/62%, ES 65/60%, YM 62/68% (n~100/90 per era); gold none
    if S != 3 and dayofweek(time, "America/New_York") == dayofweek.friday and dayofmonth(time, "America/New_York") >= 15 and dayofmonth(time, "America/New_York") <= 21
        expTxt := expTxt + " · OPEX ▼10:00 " + (S == 0 ? "59-62%" : S == 1 ? "60-65%" : "62-68%")
    // Monday after OPEX: 9:30-10:00 up NQ 63/63%, ES 56/61%, YM 56/59%
    if S != 3 and dayofweek(time, "America/New_York") == dayofweek.monday and dayofmonth(time, "America/New_York") >= 18 and dayofmonth(time, "America/New_York") <= 24
        expTxt := expTxt + " · post-OPEX ▲10:00 " + (S == 0 ? "63%" : S == 1 ? "56-61%" : "56-59%")
if nyT >= 690 or nyT < 570
    expTxt := ""
// 9:35 update: the first 5-minute range is the best early read of the 9:30-10:00 range (median by its tercile, both eras):
// NQ .26/.33/.42, ES .23/.28/.37, YM .24/.31/.41, gold .18/.23/.29 x daily range
if intraday and startOf(570)
    f5H := high
    f5L := low
else if intraday and nyT > 570 and nyT < 575 and not na(f5H)
    f5H := math.max(f5H, high)
    f5L := math.min(f5L, low)
if intraday and nyT >= 575 and nyTprev < 575 and expTxt != "" and ewStr != "" and not na(f5H) and not na(dHar)
    float r5 = (f5H - f5L) / dHar
    float q1 = S == 0 ? 0.142 : S == 1 ? 0.12 : S == 2 ? 0.14 : 0.082
    float q2 = S == 0 ? 0.195 : S == 1 ? 0.165 : S == 2 ? 0.2 : 0.121
    int z5 = r5 < q1 ? 0 : r5 > q2 ? 2 : 1
    float m5 = S == 0 ? (z5 == 0 ? 0.263 : z5 == 1 ? 0.326 : 0.423) : S == 1 ? (z5 == 0 ? 0.226 : z5 == 1 ? 0.281 : 0.37) : S == 2 ? (z5 == 0 ? 0.24 : z5 == 1 ? 0.305 : 0.412) : (z5 == 0 ? 0.179 : z5 == 1 ? 0.228 : 0.29)
    expTxt := str.replace(expTxt, "10:00 ~" + ewStr, "10:00 ~" + fmtR(m5 * dHar) + " (5m)", 0)
    // 11:30 by the same first-5-min tercile (non-news days; CPI/NFP keep the 8:30-reaction estimate), both eras:
    // NQ .44/.52/.64, ES .39/.47/.60, YM .41/.51/.62, gold .35/.41/.51
    if not newsIsToday
        float a5 = S == 0 ? (z5 == 0 ? 0.439 : z5 == 1 ? 0.516 : 0.641) : S == 1 ? (z5 == 0 ? 0.393 : z5 == 1 ? 0.474 : 0.598) : S == 2 ? (z5 == 0 ? 0.409 : z5 == 1 ? 0.508 : 0.615) : (z5 == 0 ? 0.347 : z5 == 1 ? 0.409 : 0.505)
        expTxt := str.replace(expTxt, "11:30 ~" + awStr, "11:30 ~" + fmtR(a5 * dHar), 0)
        // 75th percentile of the 9:30-11:30 range by the same tercile (both eras): NQ .58/.68/.84, ES .51/.61/.77, YM .54/.65/.79, gold .48/.55/.68
        float p75 = S == 0 ? (z5 == 0 ? 0.578 : z5 == 1 ? 0.679 : 0.842) : S == 1 ? (z5 == 0 ? 0.51 : z5 == 1 ? 0.609 : 0.774) : S == 2 ? (z5 == 0 ? 0.535 : z5 == 1 ? 0.65 : 0.791) : (z5 == 0 ? 0.48 : z5 == 1 ? 0.545 : 0.677)
        expTip := "From the first 5-minute bar: typical 9:30-11:30 range ~" + fmtR(a5 * dHar) + "; 1 morning in 4 reached ~" + fmtR(p75 * dHar) + " or more (Databento 2010-26, both eras). Typical, not a cap."

// ─────────────────────────────────────────────────────────── opening ranges (16-year stats, drawn at the OR close)
var float or15H = na
var float or15L = na
var float or30H = na
var float or30L = na
var array<box> oQ = array.new<box>()
var array<line> oLQ = array.new<line>()
var array<label> oLbQ = array.new<label>()
var string or15Txt = ""
var string or30Txt = ""
var string or15Tip = ""
var string or30Tip = ""
bool inOR15 = nyT >= 570 and nyT < 585
bool inOR30 = nyT >= 570 and nyT < 600
if intraday and startOf(570)
    or15H := high
    or15L := low
    or30H := high
    or30L := low
    or15Txt := ""
    or30Txt := ""
else
    if inOR15
        or15H := math.max(or15H, high)
        or15L := math.min(or15L, low)
    if inOR30
        or30H := math.max(or30H, high)
        or30L := math.min(or30L, low)

// cut = [p33, p67] of OR width / daily HAR; ext arrays and ft are by size (small, normal, large)
drawOR(string nm, float h, float l, array<float> cutA, array<float> u50, array<float> u80, array<float> d50, array<float> d80, array<float> ft) =>
    float w = h - l
    int t930 = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 9, 30)
    int t1130 = t930 + 120 * 60000
    float wn = w / dHar
    int sz = wn < array.get(cutA, 0) ? 0 : wn > array.get(cutA, 1) ? 2 : 1
    string grade = sz == 0 ? "small" : sz == 2 ? "large" : "normal"
    box bx = box.new(t930, h, t1130, l, xloc = xloc.bar_time, border_color = color.new(orCol, 100), border_width = 0, bgcolor = color.new(orCol, 100))   // box hidden (lines + midpoint kept)
    line l1 = line.new(time, h + array.get(u50, sz) * w, t1130, h + array.get(u50, sz) * w, xloc = xloc.bar_time, color = color.new(orCol, 55), style = line.style_dotted, width = orW)
    line l2 = line.new(time, h + array.get(u80, sz) * w, t1130, h + array.get(u80, sz) * w, xloc = xloc.bar_time, color = color.new(orCol, 10), width = orW)
    line l3 = line.new(time, l - array.get(d50, sz) * w, t1130, l - array.get(d50, sz) * w, xloc = xloc.bar_time, color = color.new(orCol, 55), style = line.style_dotted, width = orW)
    line l4 = line.new(time, l - array.get(d80, sz) * w, t1130, l - array.get(d80, sz) * w, xloc = xloc.bar_time, color = color.new(orCol, 10), width = orW)
    float f = array.get(ft, sz)
    string tip = nm + " is " + grade + " (" + fmtPts(w) + " pts). Since 2010, for " + grade + " opening ranges: by 11:30 price got past the OR high by the dashed line on half of days and the solid line on 80% (same below). After the first break it reached one more OR width before tagging the other side " + str.tostring(math.round(f * 100)) + "% of the time. Which side breaks first matched a coin flip."
    label lb = label.new(t1130, h + array.get(u80, sz) * w, nm + " ext", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny, tooltip = tip)
    string txt = grade + " " + fmtPts(w) + " · FT " + str.tostring(math.round(f * 100)) + "%"
    [bx, l1, l2, l3, l4, lb, txt, tip]

if not na(dHar) and showOR15 and intraday and timeframe.in_seconds() <= 900 and nyT >= 585 and nyTprev < 585 and nyTprev >= 570
    [bx, l1, l2, l3, l4, lb, txt, tip] = drawOR("OR15", or15H, or15L, f_or15_cut(S), f_or15_u50(S), f_or15_u80(S), f_or15_d50(S), f_or15_d80(S), f_or15_ft(S))
    array.push(oQ, bx)
    array.push(oLQ, l1)
    array.push(oLQ, l2)
    array.push(oLQ, l3)
    array.push(oLQ, l4)
    array.push(oLbQ, lb)
    or15Txt := txt
    or15Tip := tip
if not na(dHar) and showOR30 and intraday and timeframe.in_seconds() <= 1800 and nyT >= 600 and nyTprev < 600 and nyTprev >= 570
    [bx, l1, l2, l3, l4, lb, txt, tip] = drawOR("OR30", or30H, or30L, f_or30_cut(S), f_or30_u50(S), f_or30_u80(S), f_or30_d50(S), f_or30_d80(S), f_or30_ft(S))
    array.push(oQ, bx)
    array.push(oLQ, l1)
    array.push(oLQ, l2)
    array.push(oLQ, l3)
    array.push(oLQ, l4)
    array.push(oLbQ, lb)
    or30Txt := txt
    or30Tip := tip
while array.size(oQ) > sessDays * 2
    box.delete(array.shift(oQ))
while array.size(oLQ) > sessDays * 8
    line.delete(array.shift(oLQ))
while array.size(oLbQ) > sessDays * 2
    label.delete(array.shift(oLbQ))
if newDay
    or15Txt := ""
    or30Txt := ""

// ─────────────────────────────────────────────────────────── heavy opening volume (tested NQ / YM)
// 9:30-9:45 volume > 1.25x its 20-day average: OR15 breaks followed through 54/59% (NQ) and 53/58% (YM) in the
// two eras; YM also kept the 9:30-9:45 candle direction into 11:30 57/56%. ES weak, gold reversed: not shown.
var string volTxt = ""
var float rvAt945 = na
if newDay
    volTxt := ""
    rvAt945 := na
// summed from the chart's own bars (a 15m request reads the unfinished bar live and in Replay)
var float v15acc = na
var array<float> v15hist = array.new<float>()
var float orMinVol = na
float rv15 = na
if intraday and startOf(570)
    v15acc := 0.0
if intraday and nyT >= 570 and nyT < 585 and not na(v15acc)
    v15acc += nz(volume)
if intraday and nyT >= 585 and nyTprev < 585 and not na(v15acc)
    rv15 := array.size(v15hist) >= 10 ? v15acc / array.avg(v15hist) : na
    array.push(v15hist, v15acc)
    if array.size(v15hist) > 20
        array.shift(v15hist)
    orMinVol := v15acc / 15.0
    v15acc := na
if intraday and nyT >= 585 and nyTprev < 585 and not na(rv15)
    rvAt945 := rv15
    if rv15 > 1.25 and (S == 0 or S == 2)
        int dirOR = close[1] > o930 ? 1 : -1
        // audit 2026-10-05: OR break follow-through on heavy volume 53-54% in 2010-18 -> claim removed; YM lean 56.3/56.3% kept
        volTxt := "heavy x" + str.tostring(rv15, "#.#") + (S == 2 ? " · 9:45-11:30 lean " + (dirOR == 1 ? "▲" : "▼") + " 56%" : "")

// ─────────────────────────────────────────────────────────── 9:45 setups (combination search, 2010-26 1m)
// Kept only combos that held >=56% in both eras (n>=100 each) and also held on the other equity index futures.
// Outcome: direction from 9:45 to 11:30. Equities only.
var string setupTxt = ""
var color setupC = color.gray
var int setupDir = 0
var int setupKind = 0
if newDay
    setupTxt := ""
    setupDir := 0
    setupKind := 0
// gold: heavy 9:30-9:45 volume + all three overnight 4H candles + move since 18:00 agree -> 58% / 58% (n~104 each era)
// overnight VWAP (18:00-9:29) and prior regular-session VWAP (9:30-16:00), hlc3 x volume
var float onPV = 0.0
var float onVol = 0.0
var float rthPV = 0.0
var float rthVol = 0.0
var float prevRthVwap = na
var float onVwap930 = na
if newDay
    prevRthVwap := rthVol > 0 ? rthPV / rthVol : prevRthVwap
    onPV := 0.0
    onVol := 0.0
    rthPV := 0.0
    rthVol := 0.0
if intraday and (nyT >= 1080 or nyT < 570)
    onPV += hlc3 * nz(volume)
    onVol += nz(volume)
if intraday and nyT >= 570 and nyT < 960
    rthPV += hlc3 * nz(volume)
    rthVol += nz(volume)
if intraday and startOf(570)
    onVwap930 := onVol > 0 ? onPV / onVol : na
var float mnOpen = na
if newDay
    mnOpen := na
if intraday and startOf(0)
    mnOpen := open
// daily profile from the midnight open: 9:30 above it -> 9:30-11:30 makes the futures-day low only 6-16% (high 24-36%);
// below it -> day high only 5-14% (low 26-36%). Databento 1m, every era 2010-18 / 2019-22 / 2023-26, n 417-1111 each.
var string profTxt = ""
if intraday and startOf(570) and not na(mnOpen) and open != mnOpen
    bool abM = open > mnOpen
    // gap (vs yesterday's 4:00 PM close) on the same side as the midnight open sharpens it; the opposite gap weakens it
    bool agree = na(c16prev) or (abM ? open > c16prev : open < c16prev)
    string pLo = agree ? (S == 0 ? "13-15%" : S == 1 ? "8-10%" : S == 2 ? "8-13%" : "5-7%") : (S == 0 ? "18-22%" : S == 1 ? "16-19%" : S == 2 ? "13-20%" : "11-20%")
    string pHi = agree ? (S == 0 ? "9-12%" : S == 1 ? "5-8%" : S == 2 ? "5-10%" : "4-5%") : (S == 0 ? "14-19%" : S == 1 ? "10-18%" : S == 2 ? "16-21%" : "9-12%")
    profTxt := (abM ? "above 0:00 open · AM makes the day low only " + pLo : "below 0:00 open · AM makes the day high only " + pHi) + (agree ? "" : " (gap disagrees)")
    // weekly: 9:30 above the week open (Sun 18:00) -> this AM sets the week low 0-6%; below -> week high 0-5% (all markets, every era)
    if not na(wOpenHTF) and open != wOpenHTF
        profTxt := profTxt + (open > wOpenHTF ? " · week low here ≤6%" : " · week high here ≤5%")
if intraday and (newDay or startOf(690))
    profTxt := ""
// touch odds by 11:30 by distance from the 9:30 open (x daily range: .05 .1 .2 .35 inf), Databento 2010-26, eras within ~0.06
f_vwOn(int s) =>
    switch s
        0 => array.from(0.915, 0.825, 0.685, 0.525, 0.33)
        1 => array.from(0.935, 0.795, 0.655, 0.50, 0.315)
        2 => array.from(0.94, 0.80, 0.64, 0.475, 0.245)
        => array.from(0.915, 0.73, 0.57, 0.37, 0.15)
f_vwRth(int s) =>
    switch s
        0 => array.from(0.92, 0.82, 0.65, 0.415, 0.155)
        1 => array.from(0.935, 0.83, 0.62, 0.39, 0.135)
        2 => array.from(0.915, 0.82, 0.62, 0.40, 0.14)
        => array.from(0.91, 0.77, 0.565, 0.32, 0.085)
vwBin(float d) => d <= 0.05 ? 0 : d <= 0.1 ? 1 : d <= 0.2 ? 2 : d <= 0.35 ? 3 : 4
// same, re-measured from the 9:45 close for VWAPs not touched by 9:45
f_vw945On(int s) =>
    switch s
        0 => array.from(0.82, 0.74, 0.59, 0.36, 0.19)
        1 => array.from(0.92, 0.72, 0.56, 0.35, 0.21)
        2 => array.from(0.90, 0.75, 0.59, 0.34, 0.18)
        => array.from(0.80, 0.68, 0.49, 0.31, 0.11)
f_vw945Rth(int s) =>
    switch s
        0 => array.from(0.84, 0.77, 0.60, 0.34, 0.09)
        1 => array.from(0.85, 0.75, 0.55, 0.35, 0.09)
        2 => array.from(0.90, 0.75, 0.58, 0.30, 0.09)
        => array.from(0.73, 0.66, 0.51, 0.28, 0.06)

// at 9:45: typical extra range beyond the 9:30-9:45 range by 11:30 (median x daily range by OR15 size, eras within ~0.03)
if intraday and nyT >= 585 and nyTprev < 585 and expTxt != "" and not na(or15H) and not na(dHar)
    array<float> cutE = f_or15_cut(S)
    float wE = (or15H - or15L) / dHar
    int zE = wE < array.get(cutE, 0) ? 0 : wE > array.get(cutE, 1) ? 2 : 1
    float addE = S == 0 ? (zE == 0 ? 0.235 : zE == 1 ? 0.252 : 0.29) : S == 1 ? (zE == 0 ? 0.222 : zE == 1 ? 0.252 : 0.287) : S == 2 ? (zE == 0 ? 0.222 : zE == 1 ? 0.247 : 0.252) : (zE == 0 ? 0.225 : zE == 1 ? 0.236 : 0.233)
    expTxt := expTxt + " · +~" + fmtR(addE * dHar) + " past 15m"
// gold: 9:30-10:00 stayed inside the 8:20-9:29 range -> that range breaks by 11:30 70-74%; side nearer the 10:00 price
// 54-56%, far side only 21-22% (Databento 1m, 2010-18 / 2019-22 / 2023-26, n 219-842 per era)
if S == 3 and intraday and nyT >= 600 and nyTprev < 600 and expTxt != "" and not na(r820H) and not na(or30H) and or30H <= r820H and or30L >= r820L
    expTxt := expTxt + " · inside 8:20 range: breaks by 11:30 70-74% (far side 21-22%)"
// OR15 far end as the 9:30-10 stop: green 9:30-9:45 -> its low unbroken (red: its high), by where it closed and its size
// held to 10:00 74-96% / to 11:30 39-72% when it closed in the far third, all 4 markets, both eras (Databento 2010-26)
var string holdTxt = ""
var string holdTip = ""
var string hold11 = ""
var int plan30Dir = 0
var bool plan30Ext = false
var float holdLv = na
var int holdDir = 0
if intraday and startOf(570)
    holdTxt := ""
    holdLv := na
    holdDir := 0
if intraday and nyT >= 585 and nyTprev < 585 and not na(o930) and not na(or15H) and not na(dHar)
    int d15 = close[1] > o930 ? 1 : close[1] < o930 ? -1 : 0
    if d15 != 0
        float rg = math.max(or15H - or15L, syminfo.mintick)
        float clp = (close[1] - or15L) / rg
        array<float> cutH = f_or15_cut(S)
        float wN = (or15H - or15L) / dHar
        bool strongC = d15 == 1 ? clp > 2.0 / 3.0 : clp < 1.0 / 3.0
        bool weakC = d15 == 1 ? clp < 1.0 / 3.0 : clp > 2.0 / 3.0
        int cell = strongC ? (wN < array.get(cutH, 0) ? 0 : wN > array.get(cutH, 1) ? 2 : 1) : weakC ? 4 : 3
        array<int> hv = f_hold(S)
        int i = cell * 4
        string p10 = prng(array.get(hv, i), array.get(hv, i + 1))
        string p11 = prng(array.get(hv, i + 2), array.get(hv, i + 3))
        holdDir := d15
        holdLv := d15 == 1 ? or15L : or15H
        array<int> ev = f_ext(S)
        int j = cell * 3
        string pe = prng(array.get(ev, j), array.get(ev, j + 1))
        float typ = array.get(ev, j + 2) / 100.0 * rg
        string tag = strongC ? "" : weakC ? " (weak close)" : " (mid close)"
        string lvS = (d15 == 1 ? "low " : "high ") + str.tostring(holdLv, format.mintick)
        holdTxt := (d15 == 1 ? "new high " : "new low ") + pe + " (+" + fmtR(typ) + ") · " + lvS + " holds " + p10 + tag
        hold11 := lvS + " holds to 11:30 " + p11 + tag
        // gold only: large 9:30-9:45 candle closed near its end -> 9:45-10:00 went the other way 56% / 59% (n=434/477)
        if S == 3 and cell == 2
            holdTxt := holdTxt + " · pullback to 10:00 56-59%"
            holdTip := holdTip + " Gold: after a large opening candle that closed near its end, 9:45-10:00 closed against it 56% (2010-18) / 59% (2019-26) of the time."
        holdTip := "9:45-10:00: chance price trades beyond the 9:30-9:45 candle's " + (d15 == 1 ? "high" : "low") + " (" + pe + "; typical push when it does: +" + fmtPts(typ) + "), and chance its other end stays unbroken until 10:00 (" + p10 + ") / 11:30 (" + p11 + "). Based on candles that closed " + (strongC ? "near their end (" + (cell == 0 ? "small" : cell == 2 ? "large" : "normal") + " size)" : weakC ? "back near their start" : "mid-range") + ". Ranges = 2010-18 vs 2019-26 values, all on Databento 1-minute data." + (strongC ? " Timing: after a candle like this the 9:30-11:30 " + (d15 == 1 ? "high" : "low") + " printed at a median ~10:20; only 30-36% by 10:00 and 41-49% after 10:30 (all 4 markets, both eras), so early exits often leave the best price on the table." : "")
// 10:00 plan from the 9:30-10:00 range (Databento 2010-26, both eras): chance 10:00-11:30 trades beyond its close-side
// end (strong close 76-89%) and that its far end holds to 11:30 (strong close 49-85% by size)
if intraday and nyT >= 600 and nyTprev < 600 and not na(o930) and not na(or30H) and not na(dHar)
    int d30 = close[1] > o930 ? 1 : close[1] < o930 ? -1 : 0
    if d30 != 0
        float rg30 = math.max(or30H - or30L, syminfo.mintick)
        float clp30 = (close[1] - or30L) / rg30
        array<float> cut30 = f_or30_cut(S)
        float wN30 = (or30H - or30L) / dHar
        bool st30 = d30 == 1 ? clp30 > 2.0 / 3.0 : clp30 < 1.0 / 3.0
        bool wk30 = d30 == 1 ? clp30 < 1.0 / 3.0 : clp30 > 2.0 / 3.0
        int c30 = st30 ? (wN30 < array.get(cut30, 0) ? 0 : wN30 > array.get(cut30, 1) ? 2 : 1) : wk30 ? 4 : 3
        array<int> h30 = f_hold30(S)
        int q = c30 * 5
        string pb = prng(array.get(h30, q), array.get(h30, q + 1))
        string ph = prng(array.get(h30, q + 3), array.get(h30, q + 4))
        float push = array.get(h30, q + 2) / 100.0 * rg30
        holdDir := d30
        holdLv := d30 == 1 ? or30L : or30H
        plan30Dir := st30 ? d30 : 0
        plan30Ext := false
        string tag30 = st30 ? "" : wk30 ? " (weak close)" : " (mid close)"
        holdTxt := (d30 == 1 ? "new high " : "new low ") + pb + " (+" + fmtR(push) + ") · " + (d30 == 1 ? "low " : "high ") + str.tostring(holdLv, format.mintick) + " holds " + ph + tag30
        holdTip := "10:00-11:30: chance price trades beyond the 9:30-10:00 range's " + (d30 == 1 ? "high" : "low") + " (" + pb + "; typical push when it does +" + fmtPts(push) + "), and chance the range's other end stays unbroken until 11:30 (" + ph + "). Ranges = 2010-18 vs 2019-26 values (Databento 1-minute)."
        float sv10 = rthVol > 0 ? rthPV / rthVol : na
        if not na(sv10)
            float dv10 = math.abs(close[1] - sv10) / dHar
            string pv10 = dv10 <= 0.05 ? "89-92%" : dv10 <= 0.1 ? "73-79%" : dv10 <= 0.2 ? "55-61%" : ""
            if pv10 != ""
                holdTip := holdTip + " Today's 9:30-10 VWAP " + str.tostring(sv10, format.mintick) + ": price came back to it by 11:30 " + pv10 + " of the time from this distance (side of VWAP gave no direction edge)."
    else if holdDir != 0
        holdTxt := hold11
if intraday and holdDir != 0 and nyT > 585 and nyT < 690 and not na(holdLv)
    if (holdDir == 1 and low < holdLv) or (holdDir == -1 and high > holdLv)
        holdTxt := (nyT >= 600 ? "30m " : "15m ") + (holdDir == 1 ? "low " : "high ") + str.tostring(holdLv, format.mintick) + " broken"
        holdDir := 0
// 10:30 time stop for the 10:00 plan (range closed near its end): no push past it by 10:30 -> only 28-34% by 11:30 (all 4 markets, both eras)
if intraday and plan30Dir != 0 and nyT >= 600 and nyT < 630 and not na(or30H)
    if (plan30Dir == 1 and high > or30H) or (plan30Dir == -1 and low < or30L)
        plan30Ext := true
bool stall30 = intraday and plan30Dir != 0 and nyT >= 630 and nyTprev < 630 and not plan30Ext
if stall30 and holdTxt != ""
    holdTxt := holdTxt + " · no new " + (plan30Dir == 1 ? "high" : "low") + " by 10:30 -> 28-34% by 11:30"
if newDay
    plan30Dir := 0
if intraday and nyT >= 690 and nyTprev < 690
    holdTxt := ""
    holdDir := 0
if intraday and S == 3 and nyT >= 585 and nyTprev < 585 and not na(o930) and not na(dOpen)
    int s18d = o930 > dOpen ? 1 : o930 < dOpen ? -1 : 0
    if not na(rvAt945) and rvAt945 > 1.25 and h4agree != 0 and h4agree == s18d
        setupDir := h4agree
        setupTxt := (h4agree == 1 ? "▲" : "▼") + " B: heavy vol + 4H + overnight agree (56-58%)"
        setupC := h4agree == 1 ? color.new(dnBase, 0) : color.new(upBase, 0)
if intraday and S != 3 and nyT >= 585 and nyTprev < 585 and not na(o930) and not na(dHar)
    int orDir = close[1] > o930 ? 1 : close[1] < o930 ? -1 : 0
    int h4maj = int(math.sign(h4a + h4b + h4c))
    array<float> cut15 = f_or15_cut(S)
    bool abovePDH = not na(pdH) and o930 > pdH
    bool heavy = not na(rvAt945) and rvAt945 > 1.25
    // audited 2026-10-05 as displayed (one setup per day, this priority), 9:45 -> 11:30, Databento 2010-26:
    // NQ A 62.6/59.9% (n 190/212), NQ B 56.5/55.9% (n 207/136), ES B 62.7/57.3% (n 241/192). Dropped: "open > PDH + small OR"
    // and "all 4H + open agree" (coin flips once earlier setups are taken), ES A (55%) and all YM setups (54-55% in 2019-26).
    if S == 0 and abovePDH and orDir == 1
        setupDir := 1
        setupKind := 1
        setupTxt := "▲ A: open > PDH + green 9:30-45 (60-63%)"
    else if (S == 0 or S == 1) and heavy and orDir != 0 and h4maj == orDir
        setupDir := orDir
        setupKind := 3
        setupTxt := (orDir == 1 ? "▲" : "▼") + " B: heavy vol + 4H agree (" + (S == 0 ? "56-57%" : "57-63%") + ")"
    setupC := setupDir == 1 ? color.new(dnBase, 0) : setupDir == -1 ? color.new(upBase, 0) : txtDim

// 10:00 setups removed 2026-10-05: as displayed (only on days without a 9:45 setup) they ran 47-58% and failed 2010-18.

// setup targets (entry = 9:45 close, until 11:30, x daily HAR range; Databento 2010-26):
// [typical run p50, good run p75, winners' pullback p75] per symbol (NQ, ES, YM) and setup kind (1-4)
f_setupTgt(int s, int k) =>
    array<float> a = array.from(0.201, 0.318, 0.126, 0.171, 0.277, 0.125, 0.262, 0.494, 0.165, 0.206, 0.378, 0.167)
    if s == 1
        a := array.from(0.183, 0.303, 0.112, 0.139, 0.267, 0.112, 0.262, 0.449, 0.187, 0.206, 0.354, 0.156)
    else if s == 2
        a := array.from(0.191, 0.315, 0.126, 0.154, 0.252, 0.107, 0.273, 0.427, 0.192, 0.192, 0.350, 0.167)
    array.slice(a, (k - 1) * 3, k * 3)
var array<line> stQ = array.new<line>()
var float setT1 = na
var float setPB = na
var bool t1Done = false
var bool pbDone = false
if newDay
    setT1 := na
    setPB := na
    t1Done := false
    pbDone := false
var array<label> stLQ = array.new<label>()
// gold setup targets from the 9:44 close (x daily range, both eras): T1 0.20, T2 0.37, winners' pullback 0.17
if S == 3 and intraday and nyT >= 585 and nyTprev < 585 and setupDir != 0 and not na(dHar)
    float eg = close[1]
    int t1130g = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 11, 30)
    setT1 := eg + setupDir * 0.20 * dHar
    setPB := eg - setupDir * 0.17 * dHar
    color gcC = setupDir == 1 ? dnBase : upBase
    array.push(stQ, line.new(time, setT1, t1130g, setT1, xloc = xloc.bar_time, color = color.new(gcC, 20)))
    array.push(stQ, line.new(time, eg + setupDir * 0.37 * dHar, t1130g, eg + setupDir * 0.37 * dHar, xloc = xloc.bar_time, color = color.new(gcC, 45), style = line.style_dashed))
    array.push(stQ, line.new(time, setPB, t1130g, setPB, xloc = xloc.bar_time, color = color.new(invCol, 30), style = f_ls(invStyle)))
    array.push(stLQ, label.new(t1130g, setT1, "setup T1 " + fmtPx(setT1), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny, tooltip = "Gold setup: median run by 11:30 (0.20x daily range); dashed = 75th pct (0.37x), dotted = where 75% of winners held (0.17x)."))
if setupKind != 0 and setupKind[1] == 0 and S != 3 and not na(dHar)
    array<float> tg = f_setupTgt(S, setupKind)
    float e = close[1]
    int t1130 = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 11, 30)
    float t1 = e + setupDir * array.get(tg, 0) * dHar
    float t2 = e + setupDir * array.get(tg, 1) * dHar
    float pb = e - setupDir * array.get(tg, 2) * dHar
    setT1 := t1
    setPB := pb
    color sc2 = setupDir == 1 ? dnBase : upBase
    array.push(stQ, line.new(time, t1, t1130, t1, xloc = xloc.bar_time, color = color.new(sc2, 20), width = 1))
    array.push(stQ, line.new(time, t2, t1130, t2, xloc = xloc.bar_time, color = color.new(sc2, 45), style = line.style_dashed))
    array.push(stQ, line.new(time, pb, t1130, pb, xloc = xloc.bar_time, color = color.new(invCol, 30), style = f_ls(invStyle)))
    array.push(stLQ, label.new(t1130, t1, "setup T1 " + fmtPx(t1), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny, tooltip = "Typical run (median) from the 9:45 close by 11:30 after this setup, 2010-26. After T1 is hit, T2 came before a return to the 9:45 entry only 39-53% of the time (both eras), so a breakeven stop gets hit about half the time; banking part at T1 fits the data."))
    array.push(stLQ, label.new(t1130, t2, "T2 " + fmtPx(t2), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny, tooltip = "Good run (75th percentile) by 11:30 after this setup."))
    array.push(stLQ, label.new(t1130, pb, "pullback " + fmtPx(pb), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny, tooltip = "75% of winning setups never pulled back past this line before 11:30. Beyond it, the setup is usually not working."))
    while array.size(stQ) > sessDays * 3
        line.delete(array.shift(stQ))
    while array.size(stLQ) > sessDays * 3
        label.delete(array.shift(stLQ))
var bool set10 = false

// alerts for the setup's targets / pullback and the OR invalidation lines
bool t1Hit = not na(setT1) and not t1Done and nyT < 690 and (setupDir == 1 ? high >= setT1 : low <= setT1)
bool pbHit = not na(setPB) and not pbDone and nyT < 690 and (setupDir == 1 ? low <= setPB : high >= setPB)
if t1Hit
    t1Done := true
if pbHit
    pbDone := true
// setup time stop: no T1 by 10:30 -> T1 later only 17-30%, and the setup finished ahead of the 9:45 entry only 36-52% (NQ/ES/YM, both eras)
int stallT = set10 ? 645 : 630
bool setStall = intraday and not na(setT1) and not t1Done and nyT >= stallT and nyTprev < stallT
if setStall and setupTxt != ""
    setupTxt := setupTxt + (set10 ? " · no T1 by 10:45: edge gone (T1 later 18-21%)" : " · no T1 by 10:30: edge gone (T1 later 17-30%)")
    setupC := txtDim

// ─────────────────────────────────────────────────────────── OR break + invalidation (Databento 1m 2010-26)
// After the first break of the OR (before 11:30): winners rarely came back >0.5 OR width inside; once they did,
// success (one more OR width before the opposite edge) fell to ~12-23% (stable in both eras, all four markets).
var array<float> INV15 = f_inv15(S)
var array<float> INV30 = f_inv30(S)
var int brk15 = 0
var int brk30 = 0
var string invTxt = ""
var float invLv15 = na
var int brkBar15 = na
var float invLv30 = na
var array<line> iLQ = array.new<line>()
var array<label> iLbQ = array.new<label>()
if newDay
    brk15 := 0
    brk30 := 0
    invTxt := ""
    invLv15 := na
    invLv30 := na
checkBreak(int L, float h, float l, int brk, array<float> inv) =>
    int nb = brk
    string tx = ""
    line ln = na
    label lb = na
    if brk == 0 and nyT >= 570 + L and nyT < 690 and not na(h) and h > l
        float w = h - l
        if high > h and not (low < l)
            nb := 1
        else if low < l and not (high > h)
            nb := -1
        if nb != 0
            float lv = nb == 1 ? h - 0.5 * w : l + 0.5 * w
            int t1130 = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 11, 30)
            ln := line.new(time, lv, t1130, lv, xloc = xloc.bar_time, color = color.new(invCol, 20), style = f_ls(invStyle))
            string pct = str.tostring(math.round(array.get(inv, 2) * 100)) + "%"
            lb := label.new(t1130, lv, "OR" + str.tostring(L) + " invalid", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny, tooltip = "If price comes back here (0.5 OR width inside) after the " + (nb == 1 ? "upside" : "downside") + " break, the break went on to work only " + pct + " of the time since 2010 (winners rarely came back this far).")
            tx := "OR" + str.tostring(L) + (nb == 1 ? " ▲ break" : " ▼ break") + " · invalid " + fmtPx(lv) + " (then " + pct + ")"
    [nb, tx, ln, lb]
if intraday and timeframe.in_seconds() <= 900
    [nb15, tx15, ln15, lb15] = checkBreak(15, or15H, or15L, brk15, INV15)
    if nb15 != brk15
        brk15 := nb15
        invTxt := tx15
        brkBar15 := bar_index
        invLv15 := nb15 == 1 ? or15H - 0.5 * (or15H - or15L) : or15L + 0.5 * (or15H - or15L)
        array.push(iLQ, ln15)
        array.push(iLbQ, lb15)
// NQ on a 1-minute chart: break minute volume > 1.3x the average 9:30-9:45 minute -> follow-through (0.5 OR width before
// back to mid) 62.9% / 57.8% (n 485/408); judged on the closed break bar. Other markets / 5m bars: no stable edge.
if S == 0 and timeframe.in_seconds() == 60 and not na(brkBar15) and bar_index == brkBar15 + 1 and not na(orMinVol) and orMinVol > 0 and brk15 != 0
    if volume[1] / orMinVol > 1.3 and str.startswith(invTxt, "OR15")
        invTxt := invTxt + " · heavy break, FT 58-63%"
// Early failed break: first OR15 break, then a bar closes back past the OR15 mid before 10:00 -> the far side of the
// OR15 trades by 11:30 (1m/5m, era min-max 2010-18 / 2019-22 / 2023-26): NQ 75-81%, ES 73-82%, YM 70-84%, GC 76-87%
// (n 90-365 per era) vs 27-36% when the break never fails. A touch of the mid later than 10:00 is much weaker (35-65%).
var bool fail15 = false
if newDay
    fail15 := false
if intraday and timeframe.in_seconds() <= 300 and brk15 != 0 and not fail15 and not na(invLv15) and nyT + timeframe.in_seconds() / 60 <= 600
    if brk15 == 1 ? close < invLv15 : close > invLv15
        fail15 := true
        float farLv = brk15 == 1 ? or15L : or15H
        string fp = S == 0 ? "75-81%" : S == 1 ? "73-82%" : S == 2 ? "70-84%" : "76-87%"
        int t1130f = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 11, 30)
        array.push(iLQ, line.new(time, farLv, t1130f, farLv, xloc = xloc.bar_time, color = color.new(farCol, 40), style = line.style_dotted))
        array.push(iLbQ, label.new(t1130f, farLv, "OR15 far side " + fp, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny, tooltip = "The first OR15 break failed before 10:00 (a bar closed back past the OR15 mid). Since 2010 the far side of the 9:30-9:45 range then traded by 11:30 " + fp + " of the time (vs ~30% when the break holds). Stable in 2010-18, 2019-22 and 2023-26."))
        if str.startswith(invTxt, "OR15")
            invTxt := "OR15 " + (brk15 == 1 ? "▲" : "▼") + " break failed · far side " + fmtPx(farLv) + " by 11:30 " + fp
if intraday and timeframe.in_seconds() <= 1800
    [nb30, tx30, ln30, lb30] = checkBreak(30, or30H, or30L, brk30, INV30)
    if nb30 != brk30
        brk30 := nb30
        invTxt := tx30
        invLv30 := nb30 == 1 ? or30H - 0.5 * (or30H - or30L) : or30L + 0.5 * (or30H - or30L)
        array.push(iLQ, ln30)
        array.push(iLbQ, lb30)
// OR30 break checked at 10:30 (first break before 10:30, 1m/5m bars, era min-max 2010-18 / 2019-22 / 2023-26):
// no bar closed back past the OR30 mid by 10:30 -> far side by 11:30 only NQ 8-11%, ES 11-12%, YM 8-12%, GC 9-14%
// (n 555-1461 per era); a close back past the mid before 10:30 -> far side by 11:30 1m: ES 59-66, YM 56-61, GC 58-68%
// (NQ 54-59%: not shown); 5m: NQ 60-64, ES 65-73, YM 58-68, GC 60-73% (n 127-443 per era).
var bool fail30 = false
var bool held30Done = false
if newDay
    fail30 := false
    held30Done := false
bool tf5ok = timeframe.in_seconds() <= 300
if intraday and tf5ok and brk30 != 0 and not fail30 and not held30Done and not na(invLv30) and nyT + timeframe.in_seconds() / 60 <= 630
    if brk30 == 1 ? close < invLv30 : close > invLv30
        fail30 := true
        bool showF = not (S == 0 and timeframe.in_seconds() < 300)
        if showF
            float far30 = brk30 == 1 ? or30L : or30H
            bool is1m = timeframe.in_seconds() < 300
            string fp30 = is1m ? (S == 1 ? "59-66%" : S == 2 ? "56-61%" : "58-68%") : (S == 0 ? "60-64%" : S == 1 ? "65-73%" : S == 2 ? "58-68%" : "60-73%")
            int t1130g = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 11, 30)
            array.push(iLQ, line.new(time, far30, t1130g, far30, xloc = xloc.bar_time, color = color.new(farCol, 40), style = line.style_dotted))
            array.push(iLbQ, label.new(t1130g, far30, "OR30 far side " + fp30, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.small : size.tiny, tooltip = "The first OR30 break failed before 10:30 (a bar closed back past the OR30 mid). Since 2010 the far side of the 9:30-10:00 range then traded by 11:30 " + fp30 + " of the time. Stable in 2010-18, 2019-22 and 2023-26."))
            invTxt := "OR30 " + (brk30 == 1 ? "▲" : "▼") + " break failed · far side " + fmtPx(far30) + " by 11:30 " + fp30
if intraday and tf5ok and brk30 != 0 and not fail30 and not held30Done and nyT >= 630 and nyT < 690
    held30Done := true
    string hp = S == 0 ? "8-11%" : S == 1 ? "11-12%" : S == 2 ? "8-12%" : "9-14%"
    invTxt := "OR30 " + (brk30 == 1 ? "▲" : "▼") + " break held to 10:30 · far side " + fmtPx(brk30 == 1 ? or30L : or30H) + " by 11:30 only " + hp
// OR15 run one full OR width past the range (9:45-11:30) -> back to the broken OR edge by 11:30 only NQ 19-27, ES 28-33,
// YM 23-30, GC 39-45% (Databento 1m, 2010-18 / 2019-22 / 2023-26, n 371-1320 per era): don't wait for a retest.
var bool ext15Done = false
if newDay
    ext15Done := false
if intraday and not ext15Done and not na(or15H) and or15H > or15L and nyT >= 585 and nyT < 690
    float w15 = or15H - or15L
    int xd = high >= or15H + w15 ? 1 : low <= or15L - w15 ? -1 : 0
    if xd != 0
        ext15Done := true
        invTxt := "OR15 " + (xd == 1 ? "▲" : "▼") + " ran 1x OR · retest of the OR edge by 11:30 only " + (S == 0 ? "19-27%" : S == 1 ? "28-33%" : S == 2 ? "23-30%" : "39-45%")
// OR15 break that never closed back past the OR15 mid (and never tagged the far side) -> far side by 11:30, 1m/5m,
// era min-max: held to 10:00 NQ 27-31, ES 31-37, YM 26-33, GC 31-38%; held to 10:30 NQ 9-13, ES 12-15, YM 10-14,
// GC 10-16% (n 451-1465 per era).
var int held15 = 0
if newDay
    held15 := 0
if intraday and tf5ok and brk15 != 0 and not fail15 and not na(or15H) and nyT < 690
    bool farHit = brk15 == 1 ? low < or15L : high > or15H
    if farHit
        held15 := 3
    else if held15 == 0 and nyT >= 600 and str.startswith(invTxt, "OR15")
        held15 := 1
        invTxt := "OR15 " + (brk15 == 1 ? "▲" : "▼") + " break held to 10:00 · far side " + fmtPx(brk15 == 1 ? or15L : or15H) + " by 11:30 " + (S == 0 ? "27-31%" : S == 1 ? "31-37%" : S == 2 ? "26-33%" : "31-38%")
    else if held15 <= 1 and nyT >= 630 and (str.startswith(invTxt, "OR15") or brk30 == 0)
        held15 := 2
        invTxt := "OR15 " + (brk15 == 1 ? "▲" : "▼") + " break held to 10:30 · far side " + fmtPx(brk15 == 1 ? or15L : or15H) + " by 11:30 only " + (S == 0 ? "9-13%" : S == 1 ? "12-15%" : S == 2 ? "10-14%" : "10-16%")
while array.size(iLQ) > sessDays * 2
    line.delete(array.shift(iLQ))
while array.size(iLbQ) > sessDays * 2
    label.delete(array.shift(iLbQ))

// ─────────────────────────────────────────────────────────── likely targets by 11:30 (tag odds by distance, 2010-26)
var array<float> TAG = f_tag(S)
var array<float> TAGONMUL = f_tagOnMul(S)
var array<float> GAPF = f_gapfill(S)
if intraday and nyT >= 960 and nyTprev < 960
    c16 := close[1]
if newDay
    c16prev := c16
gapBin(float g) => g <= 0.05 ? 0 : g <= 0.1 ? 1 : g <= 0.2 ? 2 : g <= 0.35 ? 3 : g <= 0.6 ? 4 : 5
var array<line> tLQ = array.new<line>()
var array<label> tLbQ = array.new<label>()
var string tagTxt = ""
var float bestLv = na
var bool bestDone = false
tagBin(float d) => d <= 0.1 ? 0 : d <= 0.2 ? 1 : d <= 0.35 ? 2 : d <= 0.5 ? 3 : d <= 1.0 ? 4 : 5
if showTags and not na(dHar) and intraday and timeframe.in_seconds() <= 1800 and startOf(570)
    float bestP = 0.0
    bestLv := na
    bestDone := false
    string bestN = ""
    int t1130 = time + tOff + tLen
    // k 4/5: prior-week high / low (HTF liquidity) - reached by 11:30 on the prior-day curve (checked: within ~0.1 in
    // every era); skipped when it sits within 0.05x of the prior-day or overnight level on the same side
    // overnight range tercile (Expect-row cuts) scales the odds: big ON -> far targets likelier, quiet ON -> less
    float c1T = S == 0 ? 0.423 : S == 1 ? 0.454 : S == 2 ? 0.445 : 0.581
    float c2T = S == 0 ? 0.612 : S == 1 ? 0.656 : S == 2 ? 0.646 : 0.848
    int tqT = na(onUsed930) ? 1 : onUsed930 < c1T ? 0 : onUsed930 > c2T ? 2 : 1
    for k = 0 to 5
        float lv = k == 0 ? onH : k == 1 ? onL : k == 2 ? pdH : k == 3 ? pdL : k == 4 ? pwh : pwl
        int side = k == 0 or k == 2 or k == 4 ? 1 : -1
        string nm = k == 0 ? "ONH" : k == 1 ? "ONL" : k == 2 ? "PDH" : k == 3 ? "PDL" : k == 4 ? "PWH" : "PWL"
        int kk = k >= 4 ? k - 2 : k
        bool dup = k >= 4 and not na(lv) and (math.abs(lv - (k == 4 ? pdH : pdL)) < 0.05 * dHar or math.abs(lv - (k == 4 ? onH : onL)) < 0.05 * dHar)
        if not na(lv) and not dup
            float d = (lv - open) * side / dHar
            if d > 0
                float pr = math.min(0.97, array.get(TAG, kk * 6 + tagBin(d)) * array.get(TAGONMUL, tqT * 6 + tagBin(d)))
                if pr >= minOdds
                    array.push(tLQ, line.new(time + tOff, lv, t1130, lv, xloc = xloc.bar_time, color = color.new(tagCol, pr >= 0.5 ? 15 : 50), style = f_ls(tagStyle), width = tagW))
                    array.push(tLbQ, label.new(t1130, lv, nm + " " + str.tostring(math.round(pr * 100)) + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Chance this level gets tagged between 9:30 and 11:30, given how far it is from the 9:30 open (Databento 1m, 2010-2026, stable in both halves)."))
                if pr > bestP
                    bestP := pr
                    bestN := nm
                    bestLv := lv
    if not na(c16prev) and c16prev != open
        float g = math.abs(open - c16prev) / dHar
        float pg = array.get(GAPF, gapBin(g))
        // merge with a target label that sits within 0.05x the daily range, so labels never stack
        label near = na
        if array.size(tLbQ) > 0
            for li2 = 0 to array.size(tLbQ) - 1
                label lbx = array.get(tLbQ, li2)
                if not na(lbx) and label.get_x(lbx) == t1130 and math.abs(label.get_y(lbx) - c16prev) <= 0.05 * dHar
                    near := lbx
        if pg >= minOdds and not na(near)
            label.set_text(near, label.get_text(near) + " · GAP " + str.tostring(math.round(pg * 100)) + "%")
        if pg >= minOdds and na(near)
            array.push(tLQ, line.new(time + tOff, c16prev, t1130, c16prev, xloc = xloc.bar_time, color = color.new(tagCol, pg >= 0.5 ? 15 : 50), style = f_ls(tagStyle), width = tagW))
            array.push(tLbQ, label.new(t1130, c16prev, "GAP " + str.tostring(math.round(pg * 100)) + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Chance price trades back to yesterday's 4:00 PM close by 11:30, given the gap size (Databento 1m, 2010-2026, stable in both halves)."))
        if pg > bestP
            bestP := pg
            bestN := "GAP"
            bestLv := c16prev
        // gap CE (midpoint of yesterday's 4:00 PM close and the 9:30 open), ICT opening-gap target: reached by 11:30
        // by its distance (x daily range, bins .05/.1/.175/.25/.35); Databento 1m, eras within ~0.1, n 70+ per cell
        float ce = (open + c16prev) / 2.0
        float dce = math.abs(open - ce) / dHar
        if dce > 0.01
            int cb = dce <= 0.05 ? 0 : dce <= 0.1 ? 1 : dce <= 0.175 ? 2 : dce <= 0.25 ? 3 : dce <= 0.35 ? 4 : 5
            int pce = cb == 0 ? (S == 1 ? 95 : S == 3 ? 90 : 93) : cb == 1 ? (S == 0 ? 83 : S == 1 ? 82 : S == 2 ? 79 : 75) : cb == 2 ? (S == 3 ? 57 : S == 1 ? 67 : S == 2 ? 68 : 69) : cb == 3 ? (S == 0 ? 55 : S == 1 ? 50 : S == 2 ? 49 : 43) : cb == 4 ? (S == 3 ? 34 : S == 0 ? 39 : S == 1 ? 40 : 41) : (S == 0 ? 30 : S == 1 ? 27 : S == 2 ? 24 : 16)
            if pce >= minOdds * 100
                array.push(tLQ, line.new(time + tOff, ce, t1130, ce, xloc = xloc.bar_time, color = color.new(tagCol, pce >= 50 ? 15 : 50), style = f_ls(tagStyle), width = tagW))
                array.push(tLbQ, label.new(t1130, ce, "Gap CE " + str.tostring(pce) + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Midpoint (CE) of the opening gap between yesterday's 4:00 PM close and the 9:30 open. Chance it trades by 11:30 from this distance (Databento 1m 2010-26; 2010-18, 2019-22 and 2023-26 mostly within 10 points). Big gaps reach their CE more often than an ordinary level at the same distance."))
    // week / month open: tag by 11:30 by distance ~94/84/65/42/6% (.05/.1/.2/.35/inf), all 4 markets, both eras; shown when >= 60%
    array<float> WMO = array.from(0.94, 0.84, 0.65, 0.42, 0.06)
    // week-so-far high / low (Tue-Fri, not yet taken): by 11:30 ~90/88/56/35/10% by the same distance bins, both eras
    array<float> WSF = array.from(0.90, 0.88, 0.56, 0.35, 0.10)
    bool wsfUp = not na(dSfH) and open < dSfH
    bool wsfDn = not na(dSfL) and open > dSfL
    // midnight open: by 11:30 ~94/81/65/44/17% by the same bins (all 4 markets, both eras) - like the 18:00 open; shown when >= 60%
    for vk = 0 to 6
        float vlv = vk == 0 ? onVwap930 : vk == 1 ? prevRthVwap : vk == 2 ? wOpenHTF : vk == 3 ? mOpenHTF : vk == 4 ? (wsfUp and onH < dSfH ? dSfH : na) : vk == 5 ? (wsfDn and onL > dSfL ? dSfL : na) : mnOpen
        string vnm = vk == 0 ? "ON VWAP" : vk == 1 ? "VWAP y" : vk == 2 ? "Wk open" : vk == 3 ? "Mo open" : vk == 4 ? "Wk high" : vk == 5 ? "Wk low" : "Midnight"
        bool fresh = (vk == 2 and wOpenHTF == dOpen) or (vk == 3 and mOpenHTF == dOpen)
        if not na(vlv) and vlv != open and not fresh
            int vb = vwBin(math.abs(open - vlv) / dHar)
            float vp = vk == 0 ? array.get(f_vwOn(S), vb) : vk == 1 ? array.get(f_vwRth(S), vb) : vk == 6 ? array.get(array.from(0.94, 0.81, 0.65, 0.44, 0.17), vb) : vk >= 4 ? array.get(WSF, vb) : array.get(WMO, vb)
            if vp >= math.max(minOdds, vk == 6 or vk == 2 or vk == 3 ? 0.6 : 0.5)
                label vnear = na
                if array.size(tLbQ) > 0
                    for li4 = 0 to array.size(tLbQ) - 1
                        label lbv = array.get(tLbQ, li4)
                        if not na(lbv) and label.get_x(lbv) == t1130 and math.abs(label.get_y(lbv) - vlv) <= 0.05 * dHar
                            vnear := lbv
                if not na(vnear)
                    label.set_text(vnear, label.get_text(vnear) + " · " + vnm + " " + str.tostring(math.round(vp * 100)) + "%")
                else
                    array.push(tLQ, line.new(time + tOff, vlv, t1130, vlv, xloc = xloc.bar_time, color = color.new(tagCol, vp >= 0.7 ? 15 : 50), style = f_ls(tagStyle), width = tagW))
                    array.push(tLbQ, label.new(t1130, vlv, vnm + " " + str.tostring(math.round(vp * 100)) + "%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lblCol, size = lblBig ? size.normal : size.small, tooltip = "Chance price trades back to this VWAP (overnight 18:00-9:30, or yesterday's 9:30-16:00) by 11:30, from its distance at the open (Databento 1m 2010-26, both eras). VWAP side gives no direction edge."))
    tagTxt := bestN == "" ? "" : bestN + " · " + str.tostring(math.round(bestP * 100)) + "%"
    while array.size(tLQ) > sessDays * 7
        line.delete(array.shift(tLQ))
    while array.size(tLbQ) > sessDays * 7
        label.delete(array.shift(tLbQ))
// Gold: 8:20 COMEX open retest 9:30-11:30 by |9:30 open - 8:20 open| / daily HAR (<=.05 .1 .2 .35 >.35):
// 90-94 / 75-77 / 55-60 / 36-41 / 14-18% (Databento 1m 2010-18 / 2019-22 / 2023-26, n 123-591 per cell/era).
var float o820 = na
if newDay
    o820 := na
if S == 3 and startOf(500) and nyT < 570
    o820 := open
f_blk1() =>
